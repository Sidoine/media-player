@page "/configuration"
@using System.Globalization
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>@L["Settings_Title"] · Bobine</PageTitle>

@if (!_userStatusLoaded)
{
    <section class="settings-page"><p class="inline-message">@(_userStatusCheckFailed ? "Impossible de vérifier les droits d’accès." : "Vérification des droits d’accès…")</p></section>
}
else if (_usersEnabled && !_isAdministrator)
{
    <section class="settings-page"><p class="inline-message">Redirection vers le catalogue…</p></section>
}
else
{
<Toast Message="@ToastMessage" Variant="@ToastVariant" Trigger="@ToastTrigger" OnDismiss="ClearToast" />

<div class="settings-page">
    <a class="back-link" href="/">← Retour au catalogue</a>
    <div class="settings-title"><h1>@L["Settings_Title"]</h1><p>@L["Settings_ManageSources"]</p></div>

    <div class="settings-layout">
    <nav class="settings-nav" aria-label="@L["Settings_Sections"]">
        <button type="button" data-section="dashboard">@L["Settings_Dashboard"]</button>
        <button type="button" data-section="users">Utilisateurs</button>
        <button type="button" data-section="streaming-services">Services externes</button>
        <button type="button" data-section="language-preference">@L["Settings_Language"]</button>
        <button type="button" data-section="media-storage">@L["Settings_Storage"]</button>
        <button type="button" data-section="playback-preferences">@L["Settings_PlaybackPreferences"]</button>
        <button type="button" data-section="bittorrent-sharing">@L["Settings_Sharing"]</button>
        <button type="button" data-section="api-keys">@L["Settings_ApiKeys"]</button>
        <button type="button" data-section="indexes">@L["Settings_Indexers"]</button>
    </nav>
    <div class="settings-content">
    <PanelCard Id="dashboard" Class="indexer-dashboard" Title="@L["Settings_Dashboard"]">
        <div class="indexer-dashboard-grid">
            <article class="dashboard-card"><span class="eyebrow">SOURCES</span><strong>@(Sources.Count + SelectedIndexers.Count)</strong><span>@Sources.Count Torznab · @SelectedIndexers.Count Cardigann</span></article>
            <article class="dashboard-card"><span class="eyebrow">POPULARITÉ DES INDEXEURS</span><strong>@(PopularityStatus?.Results.Count ?? 0) médias en cache</strong><span>@PopularityLastUpdatedLabel</span><span>Actualisation automatique toutes les @PopularityRefreshHours heures</span></article>
            <article class="dashboard-card"><span class="eyebrow">DÉFINITIONS CARDIGANN</span><strong>@(CacheStatus is { Available: true } ? $"{CacheStatus.DefinitionCount} définitions en cache" : "Cache indisponible")</strong><span>@DefinitionCacheUpdatedLabel</span><AppButton Variant="glass" Class="compact" Disabled="@CacheBusy" OnClick="RefreshDefinitionsAsync">@(CacheBusy ? "…" : L["Library_Refresh"])</AppButton></article>
            <article class="dashboard-card"><span class="eyebrow">@L["Settings_BittorrentEngine"]</span><strong>@(MediaSettingsStatus is null ? "…" : L["Settings_EngineRunning"])</strong><span>@PortForwardingStatus</span>@if (MediaSettingsStatus is not null) { <span>@L["Settings_ActiveFolder"] @MediaSettingsStatus.ActiveCacheRoot</span> }</article>
        </div>
        @if (!string.IsNullOrWhiteSpace(CacheMessage)) { <div class="inline-message">@CacheMessage</div> }
        @if (MediaSettingsStatus?.RequiresRestart == true)
        {
            <div class="inline-message">
                @if (!string.Equals(MediaSettingsStatus.CacheRoot, MediaSettingsStatus.ActiveCacheRoot, StringComparison.OrdinalIgnoreCase))
                {
                    <span>@L["Settings_FolderRestart"]</span>
                }
                @if (MediaSettingsStatus.EnableUpnp != MediaSettingsStatus.ActiveEnableUpnp)
                {
                    <span>@L["Settings_UpnpRestart"]</span>
                }
                <AppButton Variant="light" Class="compact" Disabled="@IsRestartingServer" OnClick="RestartServerAsync">@(IsRestartingServer ? L["Settings_Restarting"] : L["Settings_RestartServer"])</AppButton>
                <span data-server-restart-status aria-live="polite"></span>
            </div>
        }
    </PanelCard>
    <PanelCard Id="users" Title="Utilisateurs" Description="Créez un compte pour activer le mode multiutilisateur.">
        @if (!_usersEnabled || _isAdministrator)
        {
            <div class="user-list" aria-live="polite">
                <h3>Comptes existants</h3>
                @if (_users.Count == 0)
                {
                    <p>Aucun utilisateur pour le moment.</p>
                }
                else
                {
                    <ul>
                        @foreach (var user in _users)
                        {
                            <li><strong>@user.UserName</strong><span>@(user.Role == "Administrator" ? "Administrateur" : "Utilisateur")</span>
                                <AppButton Variant="glass" Class="compact" OnClick="() => DeleteUserAsync(user.UserName)">Supprimer</AppButton>
                            </li>
                        }
                    </ul>
                }
            </div>
            <form class="source-form settings-source-form" @onsubmit="CreateUserAsync" @onsubmit:preventDefault>
                <FormTextField TValue="string" Label="Nom d’utilisateur" @bind-Value="NewUserName" Required="true" MaxLength="64" />
                <FormTextField TValue="string" Label="Mot de passe (10 caractères minimum)" @bind-Value="NewUserPassword" Type="password" AutoComplete="new-password" Required="true" />
                <AppButton Variant="light" Type="submit">@(_usersEnabled ? "Créer un utilisateur" : "Créer le premier administrateur")</AppButton>
            </form>
        }
        else { <p>Le mode multiutilisateur est actif. Connectez-vous avec un compte administrateur pour gérer les réglages.</p> }
        @if (!string.IsNullOrEmpty(UserMessage)) { <p class="inline-message">@UserMessage</p> }
    </PanelCard>
    <PanelCard Id="streaming-services" Title="Services externes" Description="Affichez les services de streaming disponibles selon un même pays de référence.">
        <div class="external-services-settings">
            <label><input type="checkbox" @bind="NetflixEnabledInput" /> Netflix</label>
            <label><input type="checkbox" @bind="PrimeVideoEnabledInput" /> Prime Video</label>
            <label class="external-country">Pays de référence
                <select @bind="StreamingCountryInput">
                    @foreach (var country in ExternalStreamingSettingsStore.Countries) { <option value="@country.Code">@country.Name (@country.Code)</option> }
                </select>
            </label>
            <AppButton Variant="light" OnClick="SaveStreamingSettingsAsync" Disabled="@StreamingSettingsBusy">@(StreamingSettingsBusy ? "Enregistrement…" : "Enregistrer")</AppButton>
        </div>
        @if (!string.IsNullOrWhiteSpace(StreamingSettingsMessage)) { <p class="inline-message">@StreamingSettingsMessage</p> }
    </PanelCard>
    <PanelCard Id="language-preference" Class="language-panel" Title="@L["Settings_Language"]" Description="@L["Settings_LanguageDescription"]">
        <FormSelect TValue="string" Label="@L["Settings_Language"]" Value="@LanguagePreference" ValueChanged="ChangeLanguageAsync">
            <option value="auto">@L["Settings_Automatic"]</option>
            <option value="fr">@L["Language_French"]</option>
            <option value="en">@L["Language_English"]</option>
        </FormSelect>
    </PanelCard>
    <PanelCard Id="media-storage" Title="@L["Settings_Storage"]" Description="@L["Settings_StorageDescription"]">
        <div class="source-form settings-source-form">
            <FormTextField TValue="string" Label="@L["Settings_StorageFolder"]" @bind-Value="MediaCacheRootInput" @bind-Value:after="SaveMediaSettingsAsync" Placeholder="/app/App_Data/media-cache" Required="true" />
            <FormTextField TValue="decimal" Label="@L["Settings_QuotaGb"]" @bind-Value="CacheQuotaGbInput" @bind-Value:after="SaveMediaSettingsAsync" Type="number" Min="0.1" Max="10240" Step="0.1" Required="true" />
        </div>
        @if (MediaSettingsStatus is not null)
        {
            var usedGb = MediaSettingsStatus.UsedBytes / 1024d / 1024 / 1024;
            var quotaGb = MediaSettingsStatus.CacheMaxBytes / 1024d / 1024 / 1024;
            <div class="storage-usage">
                <div class="storage-usage-copy"><strong>@string.Format(L["Settings_StorageUsage"], usedGb.ToString("0.0", CultureInfo.CurrentCulture), quotaGb.ToString("0.0", CultureInfo.CurrentCulture))</strong><span>@(StorageUsagePercent.ToString("0", CultureInfo.CurrentCulture) + "%")</span></div>
                <div class="storage-usage-track" role="progressbar" aria-label="@L["Settings_StorageUsage"]" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@StorageUsagePercent">
                    <div class="storage-usage-fill @(StorageUsagePercent >= 90 ? "near-limit" : null)" style="@StorageUsageStyle"></div>
                </div>
            </div>
        }
    </PanelCard>
    <PanelCard Id="playback-preferences" Title="@L["Settings_PlaybackPreferences"]" Description="@L["Settings_ResolutionDescription"]">
        <div class="source-form settings-source-form playback-settings-form">
            <FormSelect TValue="int" Label="@L["Settings_Resolution"]" @bind-Value="PreferredResolutionInput" @bind-Value:after="SaveMediaSettingsAsync">
                <option value="2160">2160p (4K)</option>
                <option value="1080">1080p</option>
                <option value="720">720p</option>
            </FormSelect>
            <FormSelect TValue="string" Label="@L["Settings_SubtitleLanguage"]" @bind-Value="SubtitleLanguagePreference" @bind-Value:after="SaveMediaSettingsAsync">
                <option value="auto">@string.Format(L["Settings_SubtitleOsLanguage"], ServerOsLanguageName)</option>
                <option value="fr">@L["Language_French"]</option>
                <option value="en">@L["Language_English"]</option>
            </FormSelect>
        </div>
    </PanelCard>
    <PanelCard Id="bittorrent-sharing" Title="@L["Settings_Sharing"]" Description="@L["Settings_SharingDescription"]">
        <div class="tracker-settings sharing-controls">
            <FormCheckbox Class="rights-check" Label="@L["Settings_UnlimitedSharing"]" @bind-Value="ShareWithoutLimit" @bind-Value:after="SaveMediaSettingsAsync" />
            @if (!ShareWithoutLimit) { <FormTextField TValue="decimal" Class="sharing-ratio" Label="@L["Settings_TargetRatio"]" @bind-Value="ShareRatioInput" @bind-Value:after="SaveMediaSettingsAsync" Type="number" Min="0" Max="1000" Step="0.1" Required="true" /> }
            <FormCheckbox Class="rights-check" Label="@L["Settings_AllowUpnp"]" @bind-Value="EnableUpnpInput" @bind-Value:after="SaveMediaSettingsAsync">
                <span class="settings-info-tooltip"><button type="button" aria-label="@L["Settings_UpnpTooltip"]" aria-describedby="upnp-tooltip">ⓘ</button><span id="upnp-tooltip" role="tooltip">@L["Settings_UpnpTooltip"]</span></span>
            </FormCheckbox>
        </div>
        @if (_usersEnabled)
        {
            <div class="anonymous-torrent-setting">
                <FormCheckbox Class="rights-check" Label="Autoriser les utilisateurs anonymes à initier des suivis et des téléchargements BitTorrent" @bind-Value="AllowAnonymousTorrentActions" @bind-Value:after="SaveMediaSettingsAsync" />
            </div>
        }
        <div class="sharing-trackers">
            <div class="sharing-trackers-heading"><h3>@L["Settings_Trackers"]</h3><span class="source-count">@string.Format(L["Settings_ConfiguredTrackers"], TrackerUrlsText.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length)</span></div>
            <p>@L["Settings_TrackersDescription"]</p>
            <div class="tracker-settings tracker-list">
                <FormTextField TValue="string" InputOnly="true" Multiline="true" Rows="5" @bind-Value="TrackerUrlsText" @bind-Value:after="SaveTrackersAsync" AriaLabel="@L["Settings_Trackers"]" Placeholder="udp://tracker.example:1337/announce" />
            </div>
        </div>
    </PanelCard>
    <PanelCard Id="api-keys" Title="@L["Settings_ApiKeys"]" Description="@L["Settings_ApiKeysDescription"]">
        <div class="source-form settings-source-form">
            <FormTextField TValue="string" Label="TMDB Read Access Token" @bind-Value="TmdbTokenInput" @bind-Value:after="SaveTmdbCredentialAsync" Type="password" AutoComplete="new-password" Placeholder="@(CredentialStatus?.TmdbSource == "local" ? "Clé locale enregistrée · saisir pour remplacer" : "TMDB Read Access Token")" Disabled="@(CredentialStatus?.TmdbSource is "secret" or "environment")" />
            <FormTextField TValue="string" Label="Clé API OpenSubtitles" @bind-Value="OpenSubtitlesKeyInput" @bind-Value:after="SaveOpenSubtitlesCredentialAsync" Type="password" AutoComplete="new-password" Placeholder="@(CredentialStatus?.OpenSubtitlesSource == "local" ? "Clé locale enregistrée · saisir pour remplacer" : "Clé API OpenSubtitles")" Disabled="@(CredentialStatus?.OpenSubtitlesSource is "secret" or "environment")" />
        </div>
        @if (CredentialStatus is not null) { <p class="credential-status">TMDB : @CredentialSourceLabel(CredentialStatus.TmdbSource) · OpenSubtitles : @CredentialSourceLabel(CredentialStatus.OpenSubtitlesSource)</p> }
    </PanelCard>

    <PanelCard Id="indexes" Title="@L["Settings_Indexers"]" HeaderNote="@($"{Sources.Count + SelectedIndexers.Count} indexeur(s)")" Description="@L["Settings_IndexersDescription"]">
        <div class="index-actions"><AppButton Variant="light" OnClick='() => OpenIndexerModal("torznab")'>@L["Settings_AddTorznab"]</AppButton><AppButton Variant="glass" OnClick='() => OpenIndexerModalAsync("cardigann")'>@L["Settings_AddCardigann"]</AppButton><AppButton Variant="glass" OnClick='() => OpenIndexerModalAsync("internal")'>@L["Settings_AddInternal"]</AppButton></div>
        @if (!string.IsNullOrWhiteSpace(SourceMessage)) { <div class="inline-message">@SourceMessage</div> }
        @if (!string.IsNullOrWhiteSpace(DefinitionMessage)) { <div class="inline-message">@DefinitionMessage</div> }
        <div class="source-list">
            @foreach (var source in Sources)
            {
                var testKey = $"torznab-{source.Id}";
                <div class="indexer-entry" @key="source.Id">
                    <div class="source-row"><span class="source-mark">↗</span><div class="source-info"><strong>@source.Name</strong><small>Torznab · @source.Url</small></div><span class="source-ok">@L["Settings_SourceRight"]</span><button class="text-button" disabled="@(TestingIndexerKey == testKey)" @onclick='() => TestIndexerAsync("torznab", source.Id, source.Name)'>@(TestingIndexerKey == testKey ? "…" : L["Settings_Test"])</button><button class="remove-button" title="@L["Settings_RemoveIndexer"]" @onclick="() => RemoveSourceAsync(source.Id)">@L["Settings_RemoveIndexer"]</button></div>
                    @if (IndexerTestMessages.TryGetValue(testKey, out var torznabTest)) { <div class="indexer-test-result">@torznabTest</div> }
                </div>
            }
            @foreach (var source in SelectedIndexers)
            {
                var testKey = $"cardigann-{source.Id}";
                <div class="indexer-entry" @key="source.Id">
                    <div class="source-row"><span class="source-mark">✦</span><div class="source-info"><strong>@source.Name</strong><small>@(source.DefinitionId == "knaben" ? "Internal index · " : "Cardigann · ")@source.DefinitionId</small></div><span class="source-ok">@L["Settings_SourceRight"]</span><button class="text-button" disabled="@(TestingIndexerKey == testKey)" @onclick='() => TestIndexerAsync("cardigann", source.Id, source.Name)'>@(TestingIndexerKey == testKey ? "…" : L["Settings_Test"])</button><button class="remove-button" title="@L["Settings_RemoveIndexer"]" @onclick="() => RemoveSelectedIndexerAsync(source.Id)">@L["Settings_RemoveIndexer"]</button></div>
                    @if (IndexerTestMessages.TryGetValue(testKey, out var cardigannTest)) { <div class="indexer-test-result">@cardigannTest</div> }
                </div>
            }
            @if (Sources.Count + SelectedIndexers.Count == 0) { <div class="empty-state compact"><strong>@L["Settings_NoIndexer"]</strong><p>@L["Settings_AddCatalogHint"]</p></div> }
        </div>
    </PanelCard>

    @if (IndexerModalType is not null)
    {
            <AppModal IsOpen="true" PanelClass="indexer-modal" AriaLabelledBy="indexer-modal-title" ShowCloseButton="true" OnClose="CloseIndexerModal">
                <div class="indexer-modal-heading"><div><div class="eyebrow">NOUVEL INDEXEUR</div><h2 id="indexer-modal-title">@(IndexerModalType == "torznab" ? "Configurer un index Torznab" : IndexerModalType == "internal" ? "Ajouter un index interne" : "Ajouter un index Cardigann")</h2></div></div>
                @if (IndexerModalType == "torznab")
                {
                    <p class="section-intro">Renseignez l’adresse API Torznab et sa clé d’accès.</p>
                    <form class="modal-form" @onsubmit="AddSourceAsync" @onsubmit:preventDefault>
                        <FormTextField TValue="string" Label="Nom" @bind-Value="NewSourceName" Placeholder="Ex. Prowlarr" MaxLength="100" Required="true" />
                        <FormTextField TValue="string" Label="URL de l’API" @bind-Value="NewSourceUrl" Type="url" Placeholder="https://serveur/1/api" Required="true" />
                        <FormTextField TValue="string" Label="Clé API" @bind-Value="NewSourceKey" Type="password" AutoComplete="new-password" Required="true" />
                        <FormCheckbox Class="rights-check" Label="Je confirme que les médias de cette source sont téléchargeables par moi." @bind-Value="RightsConfirmed" />
                        <AppButton Variant="light" Class="compact" Type="submit" Disabled="@(!RightsConfirmed)">Ajouter l’index</AppButton>
                    </form>
                }
                else
                {
                    <p class="section-intro">@(IndexerModalType == "internal" ? "Choisissez un indexeur fourni directement avec l’application." : "Recherchez une définition Cardigann dans le catalogue externe, puis ajoutez-la à votre liste d’indexeurs.")</p>
                    <form class="definition-picker" @onsubmit="SearchDefinitionsAsync" @onsubmit:preventDefault>
                        <FormTextField TValue="string" InputOnly="true" @bind-Value="DefinitionQuery" Placeholder="Filtrer les indexeurs par nom…" AriaLabel="Filtrer les définitions d’indexeurs" />
                        <AppButton Variant="glass" Class="compact" Type="submit" Disabled="@IsLoadingDefinitions">@(IsLoadingDefinitions ? "Chargement…" : "Filtrer")</AppButton>
                    </form>
                    <div class="definition-add-row">
                        <FormSelect TValue="string" InputOnly="true" @bind-Value="SelectedDefinitionId" AriaLabel="Définition à sélectionner">
                            <option value="">@(IndexerModalType == "internal" ? "Choisir un index interne…" : $"Choisir parmi {DefinitionCountText}…")</option>
                            @foreach (var definition in Definitions) { <option value="@definition.Id">@definition.Name · @definition.AccessType</option> }
                        </FormSelect>
                        <AppButton Variant="light" Class="compact" Disabled="@(string.IsNullOrWhiteSpace(SelectedDefinitionId) || !DefinitionRightsConfirmed || IsAddingDefinition)" OnClick="AddSelectedIndexerAsync">@(IsAddingDefinition ? "Ajout…" : "Ajouter l’index")</AppButton>
                    </div>
                    <FormCheckbox Class="rights-check definition-consent" Label="Je confirme disposer des droits nécessaires pour les médias de cette source." @bind-Value="DefinitionRightsConfirmed" />
                }
                @if (IndexerModalType == "torznab" && !string.IsNullOrWhiteSpace(SourceMessage)) { <div class="inline-message">@SourceMessage</div> }
                @if ((IndexerModalType is "cardigann" or "internal") && !string.IsNullOrWhiteSpace(DefinitionMessage)) { <div class="inline-message">@DefinitionMessage</div> }
            </AppModal>
    }

    <p class="rights-note">@L["Settings_RightsNotice"]</p>
    </div>
    </div>
</div>
}

@code {
    private bool _settingsNavigationInitialized;
    private bool _userStatusLoaded;
    private bool _userStatusCheckFailed;
    private bool _usersEnabled;
    private bool _isAdministrator;
    private string? _currentUserName;
    private string NewUserName = "";
    private string NewUserPassword = "";
    private string? UserMessage;
    private List<UserItem> _users = [];
    private string LanguagePreference = "auto";
    private string? IndexerModalType;

    private List<SourceItem> Sources = [];
    private List<DefinitionItem> Definitions = [];
    private List<SelectedIndexerItem> SelectedIndexers = [];
    private string NewSourceName = "";
    private string NewSourceUrl = "";
    private string NewSourceKey = "";
    private string DefinitionQuery = "";
    private string TrackerUrlsText = "";
    private string TmdbTokenInput = "";
    private string OpenSubtitlesKeyInput = "";
    private string SelectedDefinitionId = "";
    private bool RightsConfirmed;
    private bool DefinitionRightsConfirmed;
    private bool IsLoadingDefinitions;
    private bool IsAddingDefinition;
    private string MediaCacheRootInput = "";
    private decimal CacheQuotaGbInput = 500;
    private int PreferredResolutionInput = 1080;
    private bool NetflixEnabledInput = true;
    private bool PrimeVideoEnabledInput = true;
    private string StreamingCountryInput = "FR";
    private bool StreamingSettingsBusy;
    private string? StreamingSettingsMessage;
    private string SubtitleLanguagePreference = "auto";
    private bool EnableUpnpInput;
    private bool AllowAnonymousTorrentActions = true;
    private decimal ShareRatioInput = 1;
    private bool ShareWithoutLimit;
    private bool IsRestartingServer;
    private MediaSettingsResponse? MediaSettingsStatus;
    private string? ToastMessage;
    private string ToastVariant = "success";
    private long ToastTrigger;
    private readonly Dictionary<string, string> IndexerTestMessages = new(StringComparer.OrdinalIgnoreCase);
    private string? TestingIndexerKey;
    private bool CacheBusy;
    private IndexerDefinitionCacheStatus? CacheStatus;
    private PopularityStatusResponse? PopularityStatus;
    private string? SourceMessage;
    private string? CacheMessage;
    private string? DefinitionMessage;
    private CredentialStatusResponse? CredentialStatus;
    private string DefinitionCountText => CacheStatus is { DefinitionCount: > 0 } ? CacheStatus.DefinitionCount.ToString() : "les définitions disponibles";
    private string PopularityLastUpdatedLabel => PopularityStatus?.LastUpdated is { } updated
        ? $"Dernière mise à jour : {updated.ToLocalTime():g}"
        : PopularityStatus?.IsRefreshing == true ? "Synchronisation en cours…" : "En attente de la première synchronisation";
    private string DefinitionCacheUpdatedLabel => CacheStatus?.FetchedAtUtc is { } fetched
        ? $"Dernière synchronisation : {fetched.ToLocalTime():g}" : "Pas encore synchronisé";
    private int PopularityRefreshHours => PopularityStatus is null ? 8 : (int)Math.Round(PopularityStatus.RefreshIntervalHours);
    private string ServerOsLanguageName => CultureInfo.InstalledUICulture.NativeName;
    private double StorageUsagePercent => MediaSettingsStatus is { CacheMaxBytes: > 0 } status
        ? Math.Clamp(status.UsedBytes * 100d / status.CacheMaxBytes, 0, 100) : 0;
    private string StorageUsageStyle => $"width: {StorageUsagePercent.ToString("0.##", CultureInfo.InvariantCulture)}%";
    private string PortForwardingStatus
    {
        get
        {
            var forwarding = MediaSettingsStatus?.PortForwarding;
            if (forwarding is null) return "…";
            if (!forwarding.Enabled) return L["Settings_UpnpDisabled"];
            if (forwarding.Failed.Count > 0) return L["Settings_UpnpFailedStatus"];
            if (forwarding.Pending.Count > 0) return L["Settings_UpnpPendingStatus"];
            return forwarding.Created.Count > 0 ? L["Settings_UpnpActive"] : L["Settings_UpnpNoMappingsStatus"];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_settingsNavigationInitialized)
        {
            _settingsNavigationInitialized = true;
            await JS.InvokeVoidAsync("mediaSettings.init");
            LanguagePreference = await JS.InvokeAsync<string>("mediaLocalization.getPreference");
            StateHasChanged();
            await LoadAndRenderAsync();
        }
    }

    private async Task ChangeLanguageAsync(string? preference)
    {
        await JS.InvokeVoidAsync("mediaLocalization.setPreference", preference is "fr" or "en" ? preference : "auto");
    }

    private async Task LoadAndRenderAsync()
    {
        await LoadUserStatusAsync();
        if (_usersEnabled && !_isAdministrator)
        {
            Navigation.NavigateTo("/connexion", true);
            return;
        }
        await Task.WhenAll(LoadSourcesAsync(), LoadCacheStatusAsync(), LoadSelectedIndexersAsync(), LoadDefinitionsAsync(), LoadTrackersAsync(), LoadCredentialStatusAsync(), LoadPopularityStatusAsync(), LoadMediaSettingsAsync(), LoadStreamingSettingsAsync());
        StateHasChanged();
    }

    private async Task LoadUserStatusAsync()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<UserStatusResponse>("/api/users/status");
            _usersEnabled = status?.Enabled ?? false;
            _isAdministrator = status?.Administrator ?? false;
            _currentUserName = status?.UserName;
            if (status is null) return;
            _userStatusLoaded = true;
            if (!_usersEnabled || _isAdministrator)
                _users = await Http.GetFromJsonAsync<List<UserItem>>("/api/users") ?? [];
        }
        catch (Exception) { _userStatusCheckFailed = true; }
    }

    private async Task CreateUserAsync()
    {
        var response = await JS.InvokeAsync<UserPostResponse>("mediaAuth.postJson", "/api/users", new { userName = NewUserName, password = NewUserPassword });
        if (!response.Ok)
        {
            UserMessage = response.Error ?? "Impossible de créer l’utilisateur. Seul un administrateur peut ajouter des comptes.";
            return;
        }
        Navigation.NavigateTo("/configuration", true);
    }

    private async Task DeleteUserAsync(string username)
    {
        UserMessage = null;
        try
        {
            var response = await Http.DeleteAsync($"/api/users/{Uri.EscapeDataString(username)}");
            if (!response.IsSuccessStatusCode)
            {
                UserMessage = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "Un administrateur ne peut pas supprimer son propre compte."
                    : "Impossible de supprimer cet utilisateur.";
                return;
            }
            _users.RemoveAll(user => string.Equals(user.UserName, username, StringComparison.OrdinalIgnoreCase));
            if (string.Equals(username, _currentUserName, StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/configuration", true);
                return;
            }
            StateHasChanged();
        }
        catch (HttpRequestException) { UserMessage = "Impossible de joindre le serveur pour supprimer cet utilisateur."; }
    }

    private void OpenIndexerModal(string type)
    {
        IndexerModalType = type;
        SourceMessage = DefinitionMessage = null;
    }

    private async Task OpenIndexerModalAsync(string type)
    {
        IndexerModalType = type;
        SourceMessage = DefinitionMessage = null;
        DefinitionQuery = "";
        SelectedDefinitionId = "";
        await LoadDefinitionsAsync(type == "internal");
    }

    private void CloseIndexerModal() => IndexerModalType = null;

    private async Task LoadMediaSettingsAsync()
    {
        try
        {
            MediaSettingsStatus = await Http.GetFromJsonAsync<MediaSettingsResponse>("/api/configuration/media");
            if (MediaSettingsStatus is null) return;
            MediaCacheRootInput = MediaSettingsStatus.CacheRoot;
            CacheQuotaGbInput = Math.Round((decimal)MediaSettingsStatus.CacheMaxBytes / 1024 / 1024 / 1024, 1);
            PreferredResolutionInput = MediaSettingsStatus.PreferredResolution;
            SubtitleLanguagePreference = MediaSettingsStatus.SubtitleLanguage;
            EnableUpnpInput = MediaSettingsStatus.EnableUpnp;
            AllowAnonymousTorrentActions = MediaSettingsStatus.AllowAnonymousTorrentActions;
            ShareWithoutLimit = MediaSettingsStatus.ShareRatioLimit is null;
            ShareRatioInput = (decimal)(MediaSettingsStatus.ShareRatioLimit ?? 1);
        }
        catch (HttpRequestException) { ShowToast("Impossible de lire les réglages de stockage et de partage.", "error"); }
    }

    private async Task LoadStreamingSettingsAsync()
    {
        try
        {
            var value = await Http.GetFromJsonAsync<StreamingSettingsResponse>("/api/streaming/settings");
            if (value is null) return;
            NetflixEnabledInput = value.NetflixEnabled;
            PrimeVideoEnabledInput = value.PrimeVideoEnabled;
            StreamingCountryInput = value.CountryCode;
        }
        catch (HttpRequestException) { StreamingSettingsMessage = "Impossible de lire les réglages des services externes."; }
    }

    private async Task SaveStreamingSettingsAsync()
    {
        StreamingSettingsBusy = true;
        try
        {
            var response = await Http.PutAsJsonAsync("/api/streaming/settings", new { countryCode = StreamingCountryInput, netflixEnabled = NetflixEnabledInput, primeVideoEnabled = PrimeVideoEnabledInput });
            StreamingSettingsMessage = response.IsSuccessStatusCode ? "Préférences enregistrées." : "Impossible d’enregistrer les préférences.";
        }
        catch (HttpRequestException) { StreamingSettingsMessage = "Impossible d’enregistrer les préférences."; }
        finally { StreamingSettingsBusy = false; }
    }

    private async Task SaveMediaSettingsAsync()
    {
        try
        {
            var body = new { cacheRoot = MediaCacheRootInput, cacheMaxBytes = (long)(CacheQuotaGbInput * 1024 * 1024 * 1024), shareRatioLimit = ShareWithoutLimit ? (double?)null : (double)ShareRatioInput, preferredResolution = PreferredResolutionInput, enableUpnp = EnableUpnpInput, subtitleLanguage = SubtitleLanguagePreference, allowAnonymousTorrentActions = AllowAnonymousTorrentActions };
            var response = await Http.PutAsJsonAsync("/api/configuration/media", body);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                ShowToast(error?.Error ?? "Impossible d’enregistrer ces réglages.", "error");
                return;
            }
            MediaSettingsStatus = await response.Content.ReadFromJsonAsync<MediaSettingsResponse>();
            ShowToast("Réglages enregistrés.");
        }
        catch (HttpRequestException) { ShowToast("Impossible d’enregistrer ces réglages.", "error"); }
    }

    private static string FormatPortMappings(IReadOnlyList<PortMappingResponse> mappings) =>
        string.Join(" · ", mappings.Select(mapping => $"{mapping.Protocol} {mapping.PublicPort} → {mapping.PrivatePort}"));

