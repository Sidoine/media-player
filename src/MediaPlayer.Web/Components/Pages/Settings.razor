@page "/configuration"
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Configuration · Écran</PageTitle>

<Toast Message="@ToastMessage" Variant="@ToastVariant" Trigger="@ToastTrigger" OnDismiss="ClearToast" />

<div class="settings-page">
    <a class="back-link" href="/">← Retour au catalogue</a>
    <div class="settings-title"><div class="eyebrow">PRÉFÉRENCES</div><h1>Configuration</h1><p>Gérez les sources de recherche de votre espace cinéma.</p></div>

    <div class="settings-layout">
    <nav class="settings-nav" aria-label="Sections de configuration">
        <button type="button" data-section="dashboard" class="active" aria-current="location">Tableau de bord</button>
        <button type="button" data-section="media-storage">Stockage des médias</button>
        <button type="button" data-section="bittorrent-sharing">Partage BitTorrent</button>
        <button type="button" data-section="api-keys">Clés API</button>
        <button type="button" data-section="indexes">Indexeurs</button>
        <button type="button" data-section="bittorrent-trackers">Trackers BitTorrent</button>
        <button type="button" data-section="definitions-cache">Définitions d’indexeurs</button>
    </nav>
    <div class="settings-content">
    <PanelCard Id="dashboard" Class="indexer-dashboard" Eyebrow="SYNCHRONISATION ET ÉTAT" Title="Tableau de bord">
        <div class="indexer-dashboard-grid">
            <article class="dashboard-card"><span class="eyebrow">SOURCES</span><strong>@(Sources.Count + SelectedIndexers.Count)</strong><span>@Sources.Count Torznab · @SelectedIndexers.Count Cardigann</span></article>
            <article class="dashboard-card"><span class="eyebrow">POPULARITÉ DES INDEXEURS</span><strong>@(PopularityStatus?.Results.Count ?? 0) médias en cache</strong><span>@PopularityLastUpdatedLabel</span><span>Actualisation automatique toutes les @PopularityRefreshHours heures</span></article>
            <article class="dashboard-card"><span class="eyebrow">DÉFINITIONS CARDIGANN</span><strong>@(CacheStatus is { Available: true } ? $"{CacheStatus.DefinitionCount} définitions en cache" : "Cache indisponible")</strong><span>@DefinitionCacheUpdatedLabel</span></article>
        </div>
    </PanelCard>
    <PanelCard Id="media-storage" Eyebrow="BIBLIOTHÈQUE LOCALE" Title="Stockage des médias" Description="Choisissez le dossier des prochains téléchargements et la place maximale réservée aux médias. Si le cache est plein, les médias les moins récemment regardés sont supprimés en priorité.">
        <div class="source-form settings-source-form">
            <label>Dossier de stockage<input @bind="MediaCacheRootInput" @bind:after="SaveMediaSettingsAsync" placeholder="F:\\Media" required /></label>
            <label>Quota (Go)<input @bind="CacheQuotaGbInput" @bind:after="SaveMediaSettingsAsync" type="number" min="0.1" max="10240" step="0.1" required /></label>
        </div>
        @if (MediaSettingsStatus is not null) { <p class="credential-status">@($"{MediaSettingsStatus.UsedBytes / 1024d / 1024 / 1024:0.0}") Go utilisés sur @($"{(double)MediaSettingsStatus.CacheMaxBytes / 1024 / 1024 / 1024:0.0}") Go · dossier actif : @MediaSettingsStatus.ActiveCacheRoot</p> }
        @if (MediaSettingsStatus?.RequiresRestart == true) { <div class="inline-message">Le nouveau dossier sera utilisé après redémarrage. Les médias déjà présents restent dans leur dossier actuel.</div> }
    </PanelCard>
    <PanelCard Id="bittorrent-sharing" Eyebrow="ENVOI APRÈS TÉLÉCHARGEMENT" Title="Partage BitTorrent" Description="Le ratio correspond au volume envoyé divisé par le volume téléchargé. À 0, le partage s’arrête dès la fin du téléchargement.">
        <div class="tracker-settings">
            <label class="rights-check"><input @bind="ShareWithoutLimit" @bind:after="SaveMediaSettingsAsync" type="checkbox" /> Partager sans limite jusqu’à la suppression du média</label>
            @if (!ShareWithoutLimit) { <label>Ratio cible<input @bind="ShareRatioInput" @bind:after="SaveMediaSettingsAsync" type="number" min="0" max="1000" step="0.1" required /></label> }
        </div>
    </PanelCard>
    <PanelCard Id="api-keys" Eyebrow="ACCÈS AUX SERVICES" Title="Clés API" Description="Renseignez les clés TMDB et OpenSubtitles. Elles sont enregistrées localement de façon protégée. Les secrets .NET et variables d’environnement restent prioritaires.">
        <div class="source-form settings-source-form">
            <label>TMDB Read Access Token<input @bind="TmdbTokenInput" @bind:after="SaveTmdbCredentialAsync" type="password" autocomplete="new-password" placeholder="@(CredentialStatus?.TmdbSource == "local" ? "Clé locale enregistrée · saisir pour remplacer" : "TMDB Read Access Token")" disabled="@(CredentialStatus?.TmdbSource is "secret" or "environment")" /></label>
            <label>Clé API OpenSubtitles<input @bind="OpenSubtitlesKeyInput" @bind:after="SaveOpenSubtitlesCredentialAsync" type="password" autocomplete="new-password" placeholder="@(CredentialStatus?.OpenSubtitlesSource == "local" ? "Clé locale enregistrée · saisir pour remplacer" : "Clé API OpenSubtitles")" disabled="@(CredentialStatus?.OpenSubtitlesSource is "secret" or "environment")" /></label>
        </div>
        @if (CredentialStatus is not null) { <p class="credential-status">TMDB : @CredentialSourceLabel(CredentialStatus.TmdbSource) · OpenSubtitles : @CredentialSourceLabel(CredentialStatus.OpenSubtitlesSource)</p> }
    </PanelCard>

    <PanelCard Id="indexes" Eyebrow="RECHERCHE DE MÉDIAS" Title="Indexeurs" HeaderNote="@($"{Sources.Count + SelectedIndexers.Count} indexeur(s)")" Description="Gérez ici toutes les sources de recherche. Ajoutez un indexeur Torznab ou choisissez une définition Cardigann.">
        <div class="index-actions"><AppButton Variant="light" OnClick='() => OpenIndexerModal("torznab")'>Ajouter un index Torznab ＋</AppButton><AppButton Variant="glass" OnClick='() => OpenIndexerModal("cardigann")'>Ajouter un index Cardigann ＋</AppButton></div>
        @if (!string.IsNullOrWhiteSpace(SourceMessage)) { <div class="inline-message">@SourceMessage</div> }
        @if (!string.IsNullOrWhiteSpace(DefinitionMessage)) { <div class="inline-message">@DefinitionMessage</div> }
        <div class="source-list">
            @foreach (var source in Sources)
            {
                var testKey = $"torznab-{source.Id}";
                <div class="indexer-entry" @key="source.Id">
                    <div class="source-row"><span class="source-mark">↗</span><div class="source-info"><strong>@source.Name</strong><small>Torznab · @source.Url</small></div><span class="source-ok">Droits attestés</span><button class="text-button" disabled="@(TestingIndexerKey == testKey)" @onclick='() => TestIndexerAsync("torznab", source.Id, source.Name)'>@(TestingIndexerKey == testKey ? "Test…" : "Tester")</button><button class="remove-button" title="Retirer l’indexeur" @onclick="() => RemoveSourceAsync(source.Id)">Retirer</button></div>
                    @if (IndexerTestMessages.TryGetValue(testKey, out var torznabTest)) { <div class="indexer-test-result">@torznabTest</div> }
                </div>
            }
            @foreach (var source in SelectedIndexers)
            {
                var testKey = $"cardigann-{source.Id}";
                <div class="indexer-entry" @key="source.Id">
                    <div class="source-row"><span class="source-mark">✦</span><div class="source-info"><strong>@source.Name</strong><small>Cardigann · @source.DefinitionId</small></div><span class="source-ok">Droits attestés</span><button class="text-button" disabled="@(TestingIndexerKey == testKey)" @onclick='() => TestIndexerAsync("cardigann", source.Id, source.Name)'>@(TestingIndexerKey == testKey ? "Test…" : "Tester")</button><button class="remove-button" title="Retirer l’indexeur" @onclick="() => RemoveSelectedIndexerAsync(source.Id)">Retirer</button></div>
                    @if (IndexerTestMessages.TryGetValue(testKey, out var cardigannTest)) { <div class="indexer-test-result">@cardigannTest</div> }
                </div>
            }
            @if (Sources.Count + SelectedIndexers.Count == 0) { <div class="empty-state compact"><strong>Aucun indexeur configuré</strong><p>Ajoutez un catalogue Torznab ou un indexeur Cardigann.</p></div> }
        </div>
    </PanelCard>

    @if (IndexerModalType is not null)
    {
            <AppModal IsOpen="true" PanelClass="indexer-modal" AriaLabelledBy="indexer-modal-title" ShowCloseButton="true" OnClose="CloseIndexerModal">
                <div class="indexer-modal-heading"><div><div class="eyebrow">NOUVEL INDEXEUR</div><h2 id="indexer-modal-title">@(IndexerModalType == "torznab" ? "Configurer un index Torznab" : "Ajouter un index Cardigann")</h2></div></div>
                @if (IndexerModalType == "torznab")
                {
                    <p class="section-intro">Renseignez l’adresse API Torznab et sa clé d’accès.</p>
                    <form class="modal-form" @onsubmit="AddSourceAsync" @onsubmit:preventDefault>
                        <label>Nom<input @bind="NewSourceName" placeholder="Ex. Prowlarr" maxlength="100" required /></label>
                        <label>URL de l’API<input @bind="NewSourceUrl" type="url" placeholder="https://serveur/1/api" required /></label>
                        <label>Clé API<input @bind="NewSourceKey" type="password" autocomplete="new-password" required /></label>
                        <label class="rights-check"><input @bind="RightsConfirmed" type="checkbox" /> Je confirme que les médias de cette source sont téléchargeables par moi.</label>
                        <AppButton Variant="light" Class="compact" Type="submit" Disabled="@(!RightsConfirmed)">Ajouter l’index</AppButton>
                    </form>
                }
                else
                {
                    <p class="section-intro">Recherchez une définition Cardigann dans le catalogue local, puis ajoutez-la à votre liste d’indexeurs.</p>
                    <form class="definition-picker" @onsubmit="SearchDefinitionsAsync" @onsubmit:preventDefault>
                        <input @bind="DefinitionQuery" placeholder="Filtrer les indexeurs par nom…" aria-label="Filtrer les définitions d’indexeurs" />
                        <AppButton Variant="glass" Class="compact" Type="submit" Disabled="@IsLoadingDefinitions">@(IsLoadingDefinitions ? "Chargement…" : "Filtrer")</AppButton>
                    </form>
                    <div class="definition-add-row">
                        <select @bind="SelectedDefinitionId" aria-label="Définition à sélectionner">
                            <option value="">Choisir parmi @DefinitionCountText…</option>
                            @foreach (var definition in Definitions) { <option value="@definition.Id">@definition.Name · @definition.AccessType</option> }
                        </select>
                        <AppButton Variant="light" Class="compact" Disabled="@(string.IsNullOrWhiteSpace(SelectedDefinitionId) || !DefinitionRightsConfirmed || IsAddingDefinition)" OnClick="AddSelectedIndexerAsync">@(IsAddingDefinition ? "Ajout…" : "Ajouter l’index")</AppButton>
                    </div>
                    <label class="rights-check definition-consent"><input @bind="DefinitionRightsConfirmed" type="checkbox" /> Je confirme disposer des droits nécessaires pour les médias de cette source.</label>
                }
                @if (IndexerModalType == "torznab" && !string.IsNullOrWhiteSpace(SourceMessage)) { <div class="inline-message">@SourceMessage</div> }
                @if (IndexerModalType == "cardigann" && !string.IsNullOrWhiteSpace(DefinitionMessage)) { <div class="inline-message">@DefinitionMessage</div> }
            </AppModal>
    }

    <PanelCard Id="bittorrent-trackers" Eyebrow="CONNECTIVITÉ P2P" Title="Trackers BitTorrent" HeaderNote="@($"{TrackerUrlsText.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length} configuré(s)")" Description="Ces trackers sont ajoutés aux liens magnet sans trackers. Le DHT reste activé. Une adresse par ligne (UDP, HTTP ou HTTPS).">
        <div class="tracker-settings">
            <textarea @bind="TrackerUrlsText" @bind:after="SaveTrackersAsync" rows="5" aria-label="Adresses des trackers BitTorrent" placeholder="udp://tracker.example:1337/announce"></textarea>
        </div>
    </PanelCard>


    <PanelCard Id="definitions-cache" Class="cache-panel" Eyebrow="SYNCHRONISATION LOCALE" Title="Définitions d’indexeurs" HeaderActionLabel="@(CacheBusy ? "Synchronisation…" : "Actualiser ↻")" HeaderActionDisabled="@CacheBusy" OnHeaderAction="RefreshDefinitionsAsync" Description="Les définitions Cardigann v11 sont conservées dans le cache local et synchronisées au plus une fois par semaine.">
        @if (CacheStatus is null)
        {
            <div class="cache-status">Lecture de l’état du cache…</div>
        }
        else if (CacheStatus.Available)
        {
            <div class="cache-status"><span class="cache-led"></span><strong>@CacheStatus.DefinitionCount définitions en cache</strong><span>Version @CacheStatus.DefinitionVersion</span></div>
        }
        else
        {
            <div class="cache-status cache-unavailable"><span class="cache-led"></span>Aucune copie locale disponible. Une tentative sera faite au prochain démarrage.</div>
        }
        @if (!string.IsNullOrWhiteSpace(CacheMessage)) { <div class="inline-message">@CacheMessage</div> }
    </PanelCard>

    <p class="rights-note">L’attestation de droits est fournie par l’utilisateur et n’est pas une vérification indépendante des licences du catalogue.</p>
    </div>
    </div>
</div>

@code {
    private bool _settingsNavigationInitialized;
    private string? IndexerModalType;

    private List<SourceItem> Sources = [];
    private List<DefinitionItem> Definitions = [];
    private List<SelectedIndexerItem> SelectedIndexers = [];
    private string NewSourceName = "";
    private string NewSourceUrl = "";
    private string NewSourceKey = "";
    private string DefinitionQuery = "";
    private string TrackerUrlsText = "";
    private string TmdbTokenInput = "";
    private string OpenSubtitlesKeyInput = "";
    private string SelectedDefinitionId = "";
    private bool RightsConfirmed;
    private bool DefinitionRightsConfirmed;
    private bool IsLoadingDefinitions;
    private bool IsAddingDefinition;
    private string MediaCacheRootInput = "";
    private decimal CacheQuotaGbInput = 500;
    private decimal ShareRatioInput = 1;
    private bool ShareWithoutLimit;
    private MediaSettingsResponse? MediaSettingsStatus;
    private string? ToastMessage;
    private string ToastVariant = "success";
    private long ToastTrigger;
    private readonly Dictionary<string, string> IndexerTestMessages = new(StringComparer.OrdinalIgnoreCase);
    private string? TestingIndexerKey;
    private bool CacheBusy;
    private IndexerDefinitionCacheStatus? CacheStatus;
    private PopularityStatusResponse? PopularityStatus;
    private string? SourceMessage;
    private string? CacheMessage;
    private string? DefinitionMessage;
    private CredentialStatusResponse? CredentialStatus;
    private string DefinitionCountText => CacheStatus is { DefinitionCount: > 0 } ? CacheStatus.DefinitionCount.ToString() : "les définitions disponibles";
    private string PopularityLastUpdatedLabel => PopularityStatus?.LastUpdated is { } updated
        ? $"Dernière mise à jour : {updated.ToLocalTime():g}"
        : PopularityStatus?.IsRefreshing == true ? "Synchronisation en cours…" : "En attente de la première synchronisation";
    private string DefinitionCacheUpdatedLabel => CacheStatus?.FetchedAtUtc is { } fetched
        ? $"Dernière synchronisation : {fetched.ToLocalTime():g}" : "Pas encore synchronisé";
    private int PopularityRefreshHours => PopularityStatus is null ? 8 : (int)Math.Round(PopularityStatus.RefreshIntervalHours);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_settingsNavigationInitialized)
        {
            _settingsNavigationInitialized = true;
            await JS.InvokeVoidAsync("mediaSettings.init");
            await LoadAndRenderAsync();
        }
    }

    private async Task LoadAndRenderAsync()
    {
        await Task.WhenAll(LoadSourcesAsync(), LoadCacheStatusAsync(), LoadSelectedIndexersAsync(), LoadDefinitionsAsync(), LoadTrackersAsync(), LoadCredentialStatusAsync(), LoadPopularityStatusAsync(), LoadMediaSettingsAsync());
        StateHasChanged();
    }

    private void OpenIndexerModal(string type)
    {
        IndexerModalType = type;
        SourceMessage = DefinitionMessage = null;
    }

    private void CloseIndexerModal() => IndexerModalType = null;

    private async Task LoadMediaSettingsAsync()
    {
        try
        {
            MediaSettingsStatus = await Http.GetFromJsonAsync<MediaSettingsResponse>("/api/configuration/media");
            if (MediaSettingsStatus is null) return;
            MediaCacheRootInput = MediaSettingsStatus.CacheRoot;
            CacheQuotaGbInput = Math.Round((decimal)MediaSettingsStatus.CacheMaxBytes / 1024 / 1024 / 1024, 1);
            ShareWithoutLimit = MediaSettingsStatus.ShareRatioLimit is null;
            ShareRatioInput = (decimal)(MediaSettingsStatus.ShareRatioLimit ?? 1);
        }
        catch (HttpRequestException) { ShowToast("Impossible de lire les réglages de stockage et de partage.", "error"); }
    }

    private async Task SaveMediaSettingsAsync()
    {
        try
        {
            var body = new { cacheRoot = MediaCacheRootInput, cacheMaxBytes = (long)(CacheQuotaGbInput * 1024 * 1024 * 1024), shareRatioLimit = ShareWithoutLimit ? (double?)null : (double)ShareRatioInput };
            var response = await Http.PutAsJsonAsync("/api/configuration/media", body);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                ShowToast(error?.Error ?? "Impossible d’enregistrer ces réglages.", "error");
                return;
            }
            MediaSettingsStatus = await response.Content.ReadFromJsonAsync<MediaSettingsResponse>();
            ShowToast("Réglages enregistrés.");
        }
        catch (HttpRequestException) { ShowToast("Impossible d’enregistrer ces réglages.", "error"); }
    }

    private void ShowToast(string message, string variant = "success")
    {
        ToastMessage = message;
        ToastVariant = variant;
        ToastTrigger++;
    }

    private Task ClearToast()
    {
        ToastMessage = null;
        return Task.CompletedTask;
    }

    private async Task LoadPopularityStatusAsync()
    {
        try { PopularityStatus = await Http.GetFromJsonAsync<PopularityStatusResponse>("/api/catalog/indexer-popular"); }
        catch (HttpRequestException) { CacheMessage = "Impossible de lire l’état des indexeurs populaires."; }
    }

    private async Task LoadCredentialStatusAsync()
    {
        try { CredentialStatus = await Http.GetFromJsonAsync<CredentialStatusResponse>("/api/configuration/credentials"); }
        catch (HttpRequestException) { ShowToast("Impossible de lire l’état des clés API.", "error"); }
    }

    private Task SaveTmdbCredentialAsync() => SaveApiCredentialAsync(TmdbTokenInput, tmdb: true);
    private Task SaveOpenSubtitlesCredentialAsync() => SaveApiCredentialAsync(OpenSubtitlesKeyInput, tmdb: false);

    private async Task SaveApiCredentialAsync(string value, bool tmdb)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        try
        {
            var response = await Http.PutAsJsonAsync("/api/configuration/credentials", new { tmdbReadAccessToken = tmdb ? value : null, openSubtitlesApiKey = tmdb ? null : value });
            if (!response.IsSuccessStatusCode) { ShowToast("Impossible d’enregistrer les clés API.", "error"); return; }
            CredentialStatus = await response.Content.ReadFromJsonAsync<CredentialStatusResponse>();
            if (tmdb) TmdbTokenInput = ""; else OpenSubtitlesKeyInput = "";
            ShowToast("Clés API enregistrées.");
        }
        catch (HttpRequestException) { ShowToast("Impossible d’enregistrer les clés API.", "error"); }
        if (CredentialStatus?.AllConfigured == true) Navigation.NavigateTo("/", replace: true);
    }

    private static string CredentialSourceLabel(string? source) => source switch { "secret" => "secret .NET", "environment" => "variable d’environnement", "local" => "enregistrée localement", _ => "manquante" };

    private async Task LoadTrackersAsync()
    {
        try { TrackerUrlsText = string.Join(Environment.NewLine, (await Http.GetFromJsonAsync<TrackerListResponse>("/api/bittorrent/trackers"))?.Urls ?? []); }
        catch (HttpRequestException) { ShowToast("Impossible de lire la configuration des trackers.", "error"); }
    }

    private async Task SaveTrackersAsync()
    {
        try
        {
            var urls = TrackerUrlsText.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var response = await Http.PutAsJsonAsync("/api/bittorrent/trackers", new { urls });
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                ShowToast(error?.Error ?? "La configuration des trackers est invalide.", "error");
                return;
            }
            var saved = await response.Content.ReadFromJsonAsync<TrackerListResponse>();
            TrackerUrlsText = string.Join(Environment.NewLine, saved?.Urls ?? []);
            ShowToast("Trackers enregistrés.");
        }
        catch (HttpRequestException) { ShowToast("Impossible d’enregistrer les trackers.", "error"); }
    }

    private async Task LoadCacheStatusAsync()
    {
        try { CacheStatus = await Http.GetFromJsonAsync<IndexerDefinitionCacheStatus>("/api/indexer-definitions/status"); }
        catch (HttpRequestException) { CacheMessage = "Impossible de lire l’état du cache."; }
    }

    private async Task RefreshDefinitionsAsync()
    {
        CacheBusy = true;
        CacheMessage = null;
        try
        {
            CacheStatus = await (await Http.PostAsync("/api/indexer-definitions/refresh", null)).Content.ReadFromJsonAsync<IndexerDefinitionCacheStatus>();
            await LoadDefinitionsAsync();
        }
        catch (HttpRequestException) { CacheMessage = "La synchronisation GitHub a échoué; le cache existant est conservé."; }
        finally { CacheBusy = false; }
    }

    private async Task LoadDefinitionsAsync()
    {
        IsLoadingDefinitions = true;
        try { Definitions = await Http.GetFromJsonAsync<List<DefinitionItem>>("/api/indexer-definitions") ?? []; }
        catch (HttpRequestException) { DefinitionMessage = "Impossible de lire les définitions locales."; }
        finally { IsLoadingDefinitions = false; }
    }

    private async Task SearchDefinitionsAsync()
    {
        IsLoadingDefinitions = true;
        DefinitionMessage = null;
        try { Definitions = await Http.GetFromJsonAsync<List<DefinitionItem>>($"/api/indexer-definitions?query={Uri.EscapeDataString(DefinitionQuery)}") ?? []; }
        catch (HttpRequestException) { DefinitionMessage = "Impossible de filtrer les définitions locales."; }
        finally { IsLoadingDefinitions = false; }
    }

    private async Task LoadSelectedIndexersAsync()
    {
        try { SelectedIndexers = await Http.GetFromJsonAsync<List<SelectedIndexerItem>>("/api/selected-indexers") ?? []; }
        catch (HttpRequestException) { DefinitionMessage = "Impossible de charger les indexeurs sélectionnés."; }
    }

    private async Task AddSelectedIndexerAsync()
    {
        IsAddingDefinition = true;
        DefinitionMessage = null;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/selected-indexers", new { definitionId = SelectedDefinitionId, rightsConfirmed = DefinitionRightsConfirmed });
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                DefinitionMessage = error?.Error ?? "Impossible d’ajouter cette définition.";
                return;
            }
            DefinitionRightsConfirmed = false;
            DefinitionMessage = "Définition ajoutée à votre liste de sources.";
            await LoadSelectedIndexersAsync();
            CloseIndexerModal();
        }
        catch (HttpRequestException) { DefinitionMessage = "Impossible d’enregistrer cette définition."; }
        finally { IsAddingDefinition = false; }
    }

    private async Task RemoveSelectedIndexerAsync(Guid id)
    {
        try
        {
            await Http.DeleteAsync($"/api/selected-indexers/{id}");
            await LoadSelectedIndexersAsync();
            DefinitionMessage = "Définition retirée de la liste.";
        }
        catch (HttpRequestException) { DefinitionMessage = "Impossible de retirer cette définition."; }
    }

    private async Task LoadSourcesAsync()
    {
        try { Sources = await Http.GetFromJsonAsync<List<SourceItem>>("/api/torrent-catalogs") ?? []; }
        catch (HttpRequestException) { SourceMessage = "Impossible de charger les sources."; }
    }

    private async Task AddSourceAsync()
    {
        SourceMessage = null;
        if (!RightsConfirmed) { SourceMessage = "Confirmez l’attestation de droits pour ajouter cette source."; return; }
        try
        {
            var response = await Http.PostAsJsonAsync("/api/torrent-catalogs", new { name = NewSourceName, url = NewSourceUrl, apiKey = NewSourceKey, rightsConfirmed = RightsConfirmed });
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                SourceMessage = error?.Error ?? "Impossible d’ajouter la source. Vérifiez les champs.";
                return;
            }
            NewSourceName = NewSourceUrl = NewSourceKey = "";
            RightsConfirmed = false;
            SourceMessage = "Source Torznab ajoutée.";
            await LoadSourcesAsync();
            CloseIndexerModal();
        }
        catch (HttpRequestException) { SourceMessage = "Le serveur n’a pas pu enregistrer la source."; }
    }

    private async Task RemoveSourceAsync(Guid id)
    {
        try
        {
            await Http.DeleteAsync($"/api/torrent-catalogs/{id}");
            await LoadSourcesAsync();
            SourceMessage = "Source retirée.";
        }
        catch (HttpRequestException) { SourceMessage = "Impossible de retirer cette source."; }
    }

    private async Task TestIndexerAsync(string type, Guid id, string name)
    {
        var key = $"{type}-{id}";
        TestingIndexerKey = key;
        IndexerTestMessages[key] = "Recherche de test en cours…";
        try
        {
            var url = $"/api/torrent-catalogs/search?query={Uri.EscapeDataString("The Matrix")}&sourceType={Uri.EscapeDataString(type)}&sourceId={id}";
            var response = await Http.GetFromJsonAsync<SearchResponse>(url);
            var firstError = response?.Errors.FirstOrDefault();
            IndexerTestMessages[key] = !string.IsNullOrWhiteSpace(firstError)
                ? firstError
                : response?.Results.Count > 0
                    ? $"Indexeur disponible · {response.Results.Count} résultat(s) pour « The Matrix »."
                    : "Indexeur accessible · aucun résultat pour la recherche de test « The Matrix ».";
        }
        catch (HttpRequestException) { IndexerTestMessages[key] = "Échec du test : impossible de joindre cet indexeur."; }
        finally { TestingIndexerKey = null; }
    }

    private sealed record SourceItem(Guid Id, string Name, string Url, bool RightsConfirmed, DateTimeOffset AddedAt);
    private sealed record TorrentItem(string Source, string Title, string Link, string? Size, string? Seeders, string? Leechers, string? Category, bool RightsConfirmed)
    {
        public int PairCount => (int.TryParse(Seeders, out var seeders) ? seeders : 0) + (int.TryParse(Leechers, out var leechers) ? leechers : 0);
    }
    private sealed record SearchResponse(List<TorrentItem> Results, List<string> Errors);
    private sealed record ErrorResponse(string Error);
    private sealed record IndexerDefinitionCacheStatus(bool Available, int DefinitionCount, DateTimeOffset? FetchedAtUtc, string? ArchiveSha256, string SourceUrl, string? DefinitionVersion);
    private sealed record DefinitionItem(string Id, string Name, string? Description, string? Language, string? AccessType, string? Homepage);
    private sealed record SelectedIndexerItem(Guid Id, string DefinitionId, string Name, bool RightsConfirmed, DateTimeOffset AddedAt);
    private sealed record TrackerListResponse(List<string> Urls);
    private sealed record CredentialStatusResponse(bool TmdbConfigured, string TmdbSource, bool OpenSubtitlesConfigured, string OpenSubtitlesSource, bool AllConfigured);
    private sealed record MediaSettingsResponse(string CacheRoot, string ActiveCacheRoot, long CacheMaxBytes, long UsedBytes, double? ShareRatioLimit, bool RequiresRestart);
    private sealed record PopularityStatusResponse(List<JsonElement> Results, DateTimeOffset? LastUpdated, bool IsRefreshing, string? Error, double RefreshIntervalHours);
}
