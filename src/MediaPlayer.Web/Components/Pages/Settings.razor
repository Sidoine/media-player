    private sealed record UserStatusResponse(bool Enabled, bool Authenticated, bool Administrator, string? UserName);
    private sealed record UserItem(string UserName, string Role);
    private sealed record IndexerDefinitionCacheStatus(bool Available, int DefinitionCount, DateTimeOffset? FetchedAtUtc, string? ArchiveSha256, string SourceUrl, string? DefinitionVersion);
    private sealed record DefinitionItem(string Id, string Name, string? Description, string? Language, string? AccessType, string? Homepage);
    private sealed record SelectedIndexerItem(Guid Id, string DefinitionId, string Name, bool RightsConfirmed, DateTimeOffset AddedAt);
    private sealed record TrackerListResponse(List<string> Urls);
    private sealed record CredentialStatusResponse(bool TmdbConfigured, string TmdbSource, bool OpenSubtitlesConfigured, string OpenSubtitlesSource, bool AllConfigured);
    private sealed record StreamingSettingsResponse(string CountryCode, bool NetflixEnabled, bool PrimeVideoEnabled);
    private sealed record MediaSettingsResponse(string CacheRoot, string ActiveCacheRoot, long CacheMaxBytes, long UsedBytes,
        double? ShareRatioLimit, int PreferredResolution, bool EnableUpnp, bool ActiveEnableUpnp, bool AllowAnonymousTorrentActions, bool RequiresRestart,
        PortForwardingResponse? PortForwarding, string SubtitleLanguage = "auto", string ResolvedSubtitleLanguage = "en");
    private sealed record PortForwardingResponse(bool Enabled, List<PortMappingResponse> Created,
        List<PortMappingResponse> Pending, List<PortMappingResponse> Failed);
    private sealed record PortMappingResponse(string State, string Protocol, int PrivatePort, int PublicPort);
    private sealed record PopularityStatusResponse(List<JsonElement> Results, DateTimeOffset? LastUpdated, bool IsRefreshing, string? Error, double RefreshIntervalHours);
