@page "/bibliotheque"
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
<PageTitle>@L["Library_Title"] · Bobine</PageTitle>

<div class="settings-page library-page" @onclick="CloseMenu">
    <a class="back-link" href="/">@L["Library_BackHome"]</a>
    <div class="settings-title"><div class="eyebrow">@L["Library_Collection"]</div><h1>@L["Library_Title"]</h1><p>@L["Library_LocalDescription"]</p></div>

    <PanelCard Class="active-downloads-panel" Eyebrow="@L["Library_PlayingDownloads"]" Title="@L["Library_Downloads"]" HeaderActionLabel="@L["Library_Refresh"]" OnHeaderAction="LoadDownloadsAsync">
        @if (IsLoadingDownloads)
        {
            <div class="empty-state compact"><strong>@L["Library_ReadDownloads"]</strong></div>
        }
        else if (Downloads.Count == 0)
        {
            <div class="empty-state compact"><strong>@L["Library_NoActiveDownloads"]</strong></div>
        }
        else
        {
            <div class="active-download-list">
                @foreach (var download in Downloads)
                {
                    <div class="active-download-row" @key="download.TmdbId + download.MediaType">
                        <div class="active-download-heading"><strong>@download.Title</strong><span>@download.State</span></div>
                        <div class="download-progress"><span style="width:@($"{download.Progress:0.##}%")"></span></div>
                        <small>@download.Progress.ToString("0.0") % · @FormatRate(download.DownloadRate) · @download.AvailablePeers pairs · @download.TrackerCount trackers · DHT @download.DhtState</small>
                        <div class="active-download-actions">
                            @if (download.CanStream) { <AppButton Variant="light" Href="@DownloadPlaybackUrl(download)">@L["Library_PlayNow"]</AppButton> }
                            @if (!string.Equals(download.DhtState, "Ready", StringComparison.OrdinalIgnoreCase))
                            {
                                <button class="text-button" disabled="@(DiagnosingDhtKey == DownloadKey(download))" @onclick="() => DiagnoseDhtAsync(download)">@(DiagnosingDhtKey == DownloadKey(download) ? L["Library_Diagnosing"] : DhtDiagnostics.ContainsKey(DownloadKey(download)) ? L["Library_RefreshDiagnostic"] : L["Library_DiagnoseDht"])</button>
                            }
                            <button class="remove-button" disabled="@(CancelingKey == DownloadKey(download))" @onclick="() => CancelDownloadAsync(download)">@(CancelingKey == DownloadKey(download) ? L["Library_Cancelling"] : L["Library_CancelAction"])</button>
                        </div>
                        @if (DhtDiagnostics.TryGetValue(DownloadKey(download), out var diagnostic))
                        {
                            <div class="inline-message dht-diagnostic" role="status">
                                <strong>@diagnostic.Summary</strong>
                                <span>@diagnostic.Advice</span>
                                <small>DHT globale @diagnostic.DhtState · @diagnostic.KnownNodes nœuds · UDP depuis démarrage : @FormatSize(diagnostic.BytesSent) envoyés / @FormatSize(diagnostic.BytesReceived) reçus · @diagnostic.TrackerCount trackers@(diagnostic.TorrentAllowsDht is false ? " · DHT interdite par le torrent" : "")</small>
                                <small>@(diagnostic.LastDhtAnnounce is { } lastAnnounce ? $"Dernière annonce DHT : {lastAnnounce.ToLocalTime():g}" : "Aucune annonce DHT enregistrée pour ce torrent.")</small>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(DownloadMessage)) { <div class="inline-message">@DownloadMessage</div> }
    </PanelCard>

    <PanelCard Eyebrow="@L["Library_WatchlistEyebrow"]" Title="@L["Library_WatchlistTitle"]" HeaderActionLabel="@L["Library_Refresh"]" OnHeaderAction="LoadWatchlistAsync">
        @if (Watchlist.Count == 0)
        {
            <div class="empty-state compact"><strong>@L["Library_NoWatchlist"]</strong><p>@L["Library_AddWatchlistHint"]</p></div>
        }
        else
        {
            <div class="active-download-list">
                @foreach (var item in Watchlist)
                {
                    <div class="active-download-row" @key="item.Key">
                        <div class="active-download-heading"><a href="/infos/@item.MediaType/@item.TmdbId"><strong>@item.Title</strong></a><span>@(item.MediaType == "tv" ? $"S{item.SeasonNumber:00}E{item.EpisodeNumber:00}" : "Film")</span></div>
                        <small>@(item.LastCheckedAt is null ? L["Library_NextCheck"] : $"{L["Library_LastCheck"]}: {item.LastCheckedAt.Value.ToLocalTime():g}") · @L["Library_CheckEvery8Hours"]</small>
                        <div class="active-download-actions"><button class="remove-button" disabled="@(RemovingWatchKey == item.Key)" @onclick="() => RemoveWatchlistItemAsync(item)">@(RemovingWatchKey == item.Key ? L["Library_Deleting"] : L["Library_Remove"])</button></div>
                    </div>
                }
            </div>
        }
    </PanelCard>

    <PanelCard Eyebrow="@L["Library_FilesEyebrow"]" Title="@L["Library_MediaTitle"]" HeaderActionLabel="@L["Library_Refresh"]" OnHeaderAction="LoadLibraryAsync">
        @if (IsLoading)
        {
            <div class="empty-state compact"><strong>@L["Library_Loading"]</strong></div>
        }
        else if (Files.Count == 0)
        {
            <div class="empty-state compact"><span class="empty-icon">▣</span><strong>@L["Library_NoMedia"]</strong><p>@L["Library_ConfigureMediaRoot"]</p></div>
        }
        else
        {
            <div class="library-list">
                @foreach (var file in Files)
                {
                    <div class="library-entry" @key="file.Path">
                        <div class="library-item">
                            <button class="library-item-play" @onclick="() => Play(file)" aria-label="@($"{L["Library_Play"]} {DisplayMediaName(file.Name)}")"><span class="library-play">▶</span><span>@DisplayMediaName(file.Name)</span></button>
                            <div class="library-menu" @onclick:stopPropagation="true">
                                <button class="library-menu-toggle" aria-label="@($"{L["Library_Actions"]}: {file.Name}")" aria-expanded="@(OpenMenuPath == file.Path)" title="@L["Library_Actions"]" @onclick="() => ToggleMenu(file.Path)">⋮</button>
                                @if (OpenMenuPath == file.Path)
                                {
                                <div class="library-menu-options">
                                    <button @onclick="() => ShowPropertiesAsync(file)">@L["Library_Properties"]</button>
                                    <button class="danger" @onclick="() => RequestDelete(file)">@L["Library_DeleteFile"]</button>
                                </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </PanelCard>

    @if (PropertiesFile is not null)
    {
        <AppModal IsOpen="true" PanelClass="library-properties-dialog" PanelStyle="--app-modal-width:620px;--app-modal-padding:25px;--app-modal-background:#17181e;--app-modal-border:1px solid #34353d;--app-modal-radius:8px;--app-modal-shadow:0 20px 70px #000a" AriaLabelledBy="properties-title" ShowCloseButton="true" DismissOnBackdrop="false" OnClose="CloseProperties">
                <header class="library-properties-heading">
                    <h2 id="properties-title">@L["Library_Properties"]</h2>
                </header>
                @if (IsLoadingProperties)
                {
                    <div class="empty-state compact"><strong>@L["Library_LoadingProperties"]</strong></div>
                }
                else if (Properties is not null)
                {
                    <dl class="media-properties-list">
                        <div><dt>@L["Library_FileName"]</dt><dd>@Properties.FileName</dd></div>
                        <div><dt>@L["Library_Size"]</dt><dd>@FormatSize(Properties.SizeBytes)</dd></div>
                        <div><dt>@L["Library_Duration"]</dt><dd>@(Properties.Duration ?? L["Library_UnavailableValue"])</dd></div>
                        <div><dt>@L["Library_Resolution"]</dt><dd>@(Properties.Resolution ?? L["Library_UnavailableValue"])</dd></div>
                        <div><dt>@L["Library_AudioTracks"]</dt><dd>@(Properties.AudioTracks.Count == 0 ? L["Library_NoTracks"] : string.Join(" · ", Properties.AudioTracks.Where(track => !string.IsNullOrWhiteSpace(track))))</dd></div>
                        <div><dt>@L["Library_Subtitles"]</dt><dd>@(Properties.SubtitleTracks.Count == 0 ? L["Library_NoTracks"] : string.Join(" · ", Properties.SubtitleTracks))</dd></div>
                    </dl>
                }
                else
                {
                    <div class="inline-message error">@(PropertiesError ?? L["Library_PropertiesUnavailable"])</div>
                }
        </AppModal>
    }

    @if (PendingDelete is not null)
    {
        <AppModal IsOpen="true" Role="alertdialog" PanelClass="library-delete-dialog" PanelStyle="--app-modal-width:430px;--app-modal-padding:24px;--app-modal-background:#17181e;--app-modal-border:1px solid #34353d;--app-modal-radius:8px;--app-modal-shadow:0 20px 70px #000a" AriaLabelledBy="delete-title" DismissOnBackdrop="false">
                <h2 id="delete-title">@L["Library_DeleteConfirm"]</h2>
                <p>@PendingDelete.Name</p>
                @if (!string.IsNullOrWhiteSpace(DeleteMessage)) { <div class="inline-message error">@DeleteMessage</div> }
                <div class="library-delete-actions">
                    <AppButton Variant="glass" Class="compact" OnClick="CancelDelete" Disabled="@IsDeleting">@L["Library_Cancel"]</AppButton>
                    <AppButton Variant="red" Class="compact" OnClick="DeleteFileAsync" Disabled="@IsDeleting">@(IsDeleting ? L["Library_Deleting"] : L["Library_Delete"])</AppButton>
                </div>
        </AppModal>
    }
</div>

@code {
    private List<LocalFile> Files = [];
    private bool IsLoading = true;
    private bool IsLoadingDownloads = true;
    private List<MediaDownloadStatus> Downloads = [];
    private List<MediaWatchlistItem> Watchlist = [];
    private string? RemovingWatchKey;
    private string? CancelingKey;
    private string? DownloadMessage;
    private LocalFile? PendingDelete;
    private string? DeleteMessage;
    private bool IsDeleting;
    private LocalFile? PropertiesFile;
    private MediaPropertiesDto? Properties;
    private string? PropertiesError;
    private bool IsLoadingProperties;
    private string? OpenMenuPath;
    private CancellationTokenSource? downloadPolling;
    private readonly Dictionary<string, DhtDiagnosticResponse> DhtDiagnostics = new(StringComparer.OrdinalIgnoreCase);
    private string? DiagnosingDhtKey;

    protected override Task OnAfterRenderAsync(bool firstRender) => firstRender ? LoadAndRenderAsync() : Task.CompletedTask;

    private async Task LoadAndRenderAsync()
    {
        await Task.WhenAll(LoadLibraryAsync(), LoadDownloadsAsync(), LoadWatchlistAsync());
        StartPollingDownloads();
        StateHasChanged();
    }

    private async Task LoadLibraryAsync()
    {
        IsLoading = true;
        try { Files = (await Http.GetFromJsonAsync<LibraryResponse>("/api/library"))?.Items ?? []; }
        catch (HttpRequestException) { Files = []; }
        finally { IsLoading = false; }
    }

    private void Play(LocalFile file)
    {
        if (file.TmdbId > 0 && file.MediaType is "movie" or "tv")
        {
            var episodeQuery = file.SeasonNumber is not null && file.EpisodeNumber is not null
                ? $"?seasonNumber={file.SeasonNumber}&episodeNumber={file.EpisodeNumber}"
                : "";
            Navigation.NavigateTo($"/lecture/{file.MediaType}/{file.TmdbId}{episodeQuery}");
            return;
        }

        Navigation.NavigateTo($"/lecture/fichier/{file.Path}?title={Uri.EscapeDataString(DisplayMediaName(file.Name))}");
    }

    private async Task LoadDownloadsAsync()
    {
        IsLoadingDownloads = true;
        try { Downloads = await Http.GetFromJsonAsync<List<MediaDownloadStatus>>("/api/downloads") ?? []; }
        catch (HttpRequestException) { Downloads = []; DownloadMessage = "Impossible de lire l’état des téléchargements."; }
        finally { IsLoadingDownloads = false; }
    }

    private async Task LoadWatchlistAsync()
    {
        try { Watchlist = await Http.GetFromJsonAsync<List<MediaWatchlistItem>>("/api/watchlist") ?? []; }
        catch (HttpRequestException) { Watchlist = []; }
    }

    private async Task RemoveWatchlistItemAsync(MediaWatchlistItem item)
    {
        RemovingWatchKey = item.Key;
        try
        {
            using var response = await Http.DeleteAsync($"/api/watchlist/{Uri.EscapeDataString(item.Key)}");
            if (response.IsSuccessStatusCode) Watchlist.RemoveAll(entry => entry.Key == item.Key);
        }
        catch (HttpRequestException) { DownloadMessage = "Impossible de modifier la liste de surveillance."; }
        finally { RemovingWatchKey = null; }
    }

    private async Task CancelDownloadAsync(MediaDownloadStatus download)
    {
        var key = DownloadKey(download);
        CancelingKey = key;
        DownloadMessage = null;
        try
        {
            var response = await Http.DeleteAsync($"/api/downloads/{download.TmdbId}?{DownloadQuery(download)}");
            if (response.IsSuccessStatusCode)
            {
                DownloadMessage = $"Téléchargement de « {download.Title} » annulé.";
                await LoadDownloadsAsync();
            }
            else DownloadMessage = "Le téléchargement n’a pas pu être annulé.";
        }
        catch (HttpRequestException) { DownloadMessage = "Impossible de joindre le moteur BitTorrent."; }
        finally { CancelingKey = null; }
    }

    private async Task DiagnoseDhtAsync(MediaDownloadStatus download)
    {
        var key = DownloadKey(download);
        DiagnosingDhtKey = key;
        try
        {
            var diagnostic = await Http.GetFromJsonAsync<DhtDiagnosticResponse>($"/api/downloads/{download.TmdbId}/dht-diagnostic?{DownloadQuery(download)}");
            if (diagnostic is not null) DhtDiagnostics[key] = diagnostic;
            else DownloadMessage = "Le diagnostic DHT est indisponible pour ce téléchargement.";
        }
        catch (HttpRequestException) { DownloadMessage = "Impossible de récupérer le diagnostic DHT."; }
        finally { DiagnosingDhtKey = null; }
    }

    private static string DisplayMediaName(string name)
    {
        var match = System.Text.RegularExpressions.Regex.Match(name,
            @"(?i)(?:\bS(?<season>\d{1,2})\s*E(?<episode>\d{1,3})\b|\b(?<season>\d{1,2})x(?<episode>\d{1,3})\b)");
        if (!match.Success) return name;

        var series = name[..match.Index].Trim(' ', '.', '-', '_', '[', '(');
        if (string.IsNullOrWhiteSpace(series))
            series = name[(match.Index + match.Length)..].Trim(' ', '.', '-', '_', ']', ')');
        if (string.IsNullOrWhiteSpace(series)) series = name;

        var season = int.Parse(match.Groups["season"].Value);
        var episode = int.Parse(match.Groups["episode"].Value);
        return $"{series} — Saison {season}, épisode {episode}";
    }

    private async Task ShowPropertiesAsync(LocalFile file)
    {
        CloseMenu();
        PropertiesFile = file;
        Properties = null;
        PropertiesError = null;
        IsLoadingProperties = true;
        try
        {
            var response = await Http.GetAsync($"/api/library/properties/{Uri.EscapeDataString(file.Path)}");
            if (response.IsSuccessStatusCode)
                Properties = await response.Content.ReadFromJsonAsync<MediaPropertiesDto>();
            else PropertiesError = "Les propriétés n’ont pas pu être récupérées.";
        }
        catch (HttpRequestException) { PropertiesError = "Impossible de joindre le serveur."; }
        finally { IsLoadingProperties = false; }
    }

    private void CloseProperties()
    {
        PropertiesFile = null;
        Properties = null;
    }

    private void RequestDelete(LocalFile file)
    {
        CloseMenu();
        PendingDelete = file;
        DeleteMessage = null;
    }

    private void ToggleMenu(string path) => OpenMenuPath = OpenMenuPath == path ? null : path;

    private void CloseMenu() => OpenMenuPath = null;

    private void CancelDelete()
    {
        if (IsDeleting) return;
        PendingDelete = null;
        DeleteMessage = null;
    }

    private async Task DeleteFileAsync()
    {
        if (PendingDelete is null || IsDeleting) return;
        IsDeleting = true;
        DeleteMessage = null;
        try
        {
            var response = await Http.DeleteAsync($"/api/library/{Uri.EscapeDataString(PendingDelete.Path)}");
            if (response.IsSuccessStatusCode)
            {
                Files.RemoveAll(file => file.Path == PendingDelete.Path);
                PendingDelete = null;
            }
            else DeleteMessage = "Le fichier n’a pas pu être supprimé.";
        }
        catch (HttpRequestException) { DeleteMessage = "Impossible de joindre le serveur."; }
        finally { IsDeleting = false; }
    }

    private void StartPollingDownloads()
    {
        downloadPolling?.Cancel();
        downloadPolling = new CancellationTokenSource();
        _ = PollDownloadsAsync(downloadPolling.Token);
    }

    private async Task PollDownloadsAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await LoadDownloadsAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private static string DownloadKey(MediaDownloadStatus download) => $"{download.MediaType}-{download.TmdbId}-{download.SeasonNumber}-{download.EpisodeNumber}";
    private static string DownloadPlaybackUrl(MediaDownloadStatus download) =>
        $"/lecture/{download.MediaType}/{download.TmdbId}" + (download.SeasonNumber is not null && download.EpisodeNumber is not null
            ? $"?seasonNumber={download.SeasonNumber}&episodeNumber={download.EpisodeNumber}"
            : "");
    private static string DownloadQuery(MediaDownloadStatus download) =>
        $"mediaType={Uri.EscapeDataString(download.MediaType)}" + (download.SeasonNumber is not null && download.EpisodeNumber is not null
            ? $"&seasonNumber={download.SeasonNumber}&episodeNumber={download.EpisodeNumber}"
            : "");
    private static string FormatRate(long bytesPerSecond) => bytesPerSecond > 0 ? $"{bytesPerSecond / 1024d / 1024:0.0} Mo/s" : "débit nul";
    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1_000_000_000 => $"{bytes / 1_000_000_000d:0.##} Go",
        >= 1_000_000 => $"{bytes / 1_000_000d:0.##} Mo",
        >= 1_000 => $"{bytes / 1_000d:0.##} Ko",
        _ => $"{bytes} octets"
    };

    public void Dispose() => downloadPolling?.Cancel();

    private sealed record LibraryResponse(List<LocalFile> Items);
    private sealed record LocalFile(string Name, string Path, int TmdbId, string MediaType, int? SeasonNumber, int? EpisodeNumber, string? PosterUrl = null);
    private sealed record MediaPropertiesDto(string FileName, long SizeBytes, string? Duration, string? Resolution,
        List<string?> AudioTracks, List<string> SubtitleTracks);
    private sealed record MediaDownloadStatus(int TmdbId, string MediaType, string Title, string State, double Progress, long DownloadRate,
        string Directory, bool Completed, string SourceTitle, int AvailablePeers, int TrackerCount, string DhtState,
        int? SeasonNumber, int? EpisodeNumber, long BufferedBytes, long RequiredBufferBytes, bool CanStream);
    private sealed record DhtDiagnosticResponse(string DhtState, bool DhtEnabled, int KnownNodes, long BytesSent, long BytesReceived,
        bool? TorrentAllowsDht, int TrackerCount, DateTimeOffset? LastDhtAnnounce, string Summary, string Advice);
    private sealed record MediaWatchlistItem(string Key, int TmdbId, string MediaType, string Title, string OriginalLanguage,
        int? Year, int? SeasonNumber, int? EpisodeNumber, string? EpisodeTitle, int? RuntimeMinutes, DateTimeOffset AddedAt, DateTimeOffset? LastCheckedAt);
}
