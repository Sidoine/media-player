@page "/bienvenue"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>@T("Première configuration", "First setup") · Bobine</PageTitle>

<section class="welcome-page">
    <div class="welcome-card">
        <div class="welcome-mark">BOBINE</div>
        <p class="welcome-kicker">@T("VOTRE SERVEUR EST PRÊT", "YOUR SERVER IS READY")</p>
        <h1>@T("Bienvenue chez vous.", "Welcome home.")</h1>
        <p class="welcome-intro">@T("Le dossier a été choisi dans la fenêtre précédente. Il n’y a rien à saisir ici.", "The folder was selected in the previous dialog. There is nothing to type here.")</p>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p class="welcome-message @(IsError ? "error" : null)" role="status">@Message</p>
        }

        <div class="welcome-folder">
            <span>@T("Dossier des médias sélectionné", "Selected media folder")</span>
            @if (string.IsNullOrWhiteSpace(MediaRoot))
            {
                <strong>@T("Lecture des réglages…", "Loading settings…")</strong>
            }
            else
            {
                <code title="@MediaRoot">@MediaRoot</code>
            }
        </div>

        <form class="welcome-fields" @onsubmit="FinishAsync" @onsubmit:preventDefault>
            <label>TMDB Read Access Token <span>@(TmdbConfigured ? T("(déjà configurée)", "(already configured)") : T("(obligatoire)", "(required)"))</span>
                <input @bind="TmdbToken" type="password" autocomplete="new-password" placeholder="@(TmdbConfigured ? T("Clé déjà enregistrée", "Key already saved") : "Read Access Token")" required="@(!TmdbConfigured)" />
            </label>
            <label>OpenSubtitles API key <span>@(OpenSubtitlesConfigured ? T("(déjà configurée)", "(already configured)") : T("(obligatoire)", "(required)"))</span>
                <input @bind="OpenSubtitlesKey" type="password" autocomplete="new-password" placeholder="@(OpenSubtitlesConfigured ? T("Clé déjà enregistrée", "Key already saved") : "API key")" required="@(!OpenSubtitlesConfigured)" />
            </label>
            <button class="welcome-primary" type="submit" disabled="@(Busy || string.IsNullOrWhiteSpace(MediaRoot))">@(Busy ? T("Enregistrement…", "Saving…") : T("Enregistrer et ouvrir Bobine", "Save and open Bobine"))</button>
        </form>

        <p class="welcome-footnote">@T("Les deux clés sont nécessaires au fonctionnement de Bobine. Elles sont enregistrées localement et chiffrées.", "Both keys are required for Bobine. They are stored locally in encrypted form.")</p>
    </div>
</section>

@code {
    private string MediaRoot = "";
    private string TmdbToken = "";
    private string OpenSubtitlesKey = "";
    private string? Message;
    private bool Busy;
    private bool IsError;
    private bool TmdbConfigured;
    private bool OpenSubtitlesConfigured;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<MediaResponse>("/api/configuration/media");
            var credentials = await Http.GetFromJsonAsync<CredentialResponse>("/api/configuration/credentials");
            MediaRoot = settings?.CacheRoot ?? "";
            TmdbConfigured = credentials?.TmdbConfigured == true;
            OpenSubtitlesConfigured = credentials?.OpenSubtitlesConfigured == true;
            if (string.IsNullOrWhiteSpace(MediaRoot))
                throw new InvalidOperationException(T("Le dossier média n’a pas été sélectionné.", "No media folder was selected."));
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            Message = ex is InvalidOperationException ? ex.Message : T("Impossible de lire les réglages du serveur. Réessayez.", "Couldn't read the server settings. Please try again.");
            IsError = true;
        }
    }

    private async Task FinishAsync()
    {
        if (Busy) return;
        if ((!TmdbConfigured && string.IsNullOrWhiteSpace(TmdbToken))
            || (!OpenSubtitlesConfigured && string.IsNullOrWhiteSpace(OpenSubtitlesKey)))
        {
            Message = T("Saisissez les deux clés API pour continuer.", "Enter both API keys to continue.");
            IsError = true;
            return;
        }

        Busy = true;
        Message = null;
        IsError = false;
        try
        {
            if (!string.IsNullOrWhiteSpace(TmdbToken) || !string.IsNullOrWhiteSpace(OpenSubtitlesKey))
            {
                var credentialResponse = await Http.PutAsJsonAsync("/api/configuration/credentials", new
                {
                    tmdbReadAccessToken = TmdbToken,
                    openSubtitlesApiKey = OpenSubtitlesKey
                });
                if (!credentialResponse.IsSuccessStatusCode)
                    throw new InvalidOperationException(T("Impossible d’enregistrer les clés API.", "Couldn't save the API keys."));
            }

            var status = await Http.GetFromJsonAsync<MediaResponse>("/api/configuration/media");
            if (status is null) throw new HttpRequestException();
            var mediaResponse = await Http.PutAsJsonAsync("/api/configuration/media", new
            {
                cacheRoot = MediaRoot,
                cacheMaxBytes = status.CacheMaxBytes,
                shareRatioLimit = status.ShareRatioLimit,
                preferredResolution = status.PreferredResolution,
                enableUpnp = status.EnableUpnp,
                subtitleLanguage = status.SubtitleLanguage,
                allowAnonymousTorrentActions = status.AllowAnonymousTorrentActions
            });
            if (!mediaResponse.IsSuccessStatusCode)
            {
                var error = await mediaResponse.Content.ReadFromJsonAsync<ErrorResponse>();
                throw new InvalidOperationException(error?.Error ?? T("Impossible d’enregistrer le dossier média.", "Couldn't save the media folder."));
            }

            var completion = await Http.PostAsync("/api/setup/complete", content: null);
            if (!completion.IsSuccessStatusCode)
                throw new InvalidOperationException(T("Les deux clés sont obligatoires pour terminer la configuration.", "Both API keys are required to finish setup."));
            Navigation.NavigateTo("/", forceLoad: true, replace: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            Message = ex is InvalidOperationException ? ex.Message : T("Le serveur ne répond pas. Réessayez dans quelques instants.", "The server isn't responding. Please try again in a moment.");
            IsError = true;
        }
        finally { Busy = false; }
    }

    private sealed record MediaResponse(string CacheRoot, long CacheMaxBytes, double? ShareRatioLimit,
        int PreferredResolution, bool EnableUpnp, bool AllowAnonymousTorrentActions, string SubtitleLanguage);
    private sealed record CredentialResponse(bool TmdbConfigured, bool OpenSubtitlesConfigured);
    private sealed record ErrorResponse(string? Error);
    private static string T(string french, string english) => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr" ? french : english;
}
