    public async ValueTask DisposeAsync()
    {
        isDisposed = true;
        Interlocked.Increment(ref genreLoadVersion);
        Navigation.LocationChanged -= HandleLocationChanged;
        heroRotationTimer?.Dispose();
        genreDotNetReference?.Dispose();
        if (genreLazyModule is not null)
        {
            try { await genreLazyModule.InvokeVoidAsync("disconnect"); }
            catch (JSDisconnectedException) { }
            await genreLazyModule.DisposeAsync();
        }
        if (carouselModule is not null)
        {
            try { await carouselModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
