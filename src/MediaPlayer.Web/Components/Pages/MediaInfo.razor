@page "/infos/{MediaType}/{TmdbId:int}"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>@(Details?.Title ?? L["Nav_MoreInfo"]) · Bobine</PageTitle>

@if (IsLoading)
{
    <section class="media-info-loading"><span class="spinner"></span><span>@L["Details_Loading"]</span></section>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <section class="media-info-error"><h1>@L["Details_Unavailable"]</h1><p>@ErrorMessage</p><AppButton Variant="light" Href="@CatalogUrl">@L["Details_BackCatalog"]</AppButton></section>
}
else if (Details is not null)
{
    <div class="media-info-page @(MediaType == "tv" ? "series-info-page" : "")">
        <section class="media-info-hero" style="@BackdropStyle">
            <div class="media-info-shade"></div>
            <div class="media-info-copy">
                <a class="media-info-back" href="@CatalogUrl">@(MediaType == "tv" ? L["Back_Series"] : L["Back_Movies"])</a>
                <div class="eyebrow">@L[MediaType == "tv" ? "Details_Series" : "Details_Movie"]</div>
                <h1>@Details.Title</h1>
                <div class="media-info-facts">
                    @if (Details.Year is not null) { <span>@Details.Year</span> }
                    @if (Details.Rating > 0) { <span>★ @Details.Rating.ToString("0.0") / 10</span> }
                    @if (Details.RuntimeMinutes is not null) { <span>@FormatRuntime(Details.RuntimeMinutes.Value)</span> }
                    @if (Details.SeasonCount is not null) { <span>@string.Format(L["Details_SeasonEpisodes"], Details.SeasonCount, Details.EpisodeCount)</span> }
                </div>
                @if (Details.Genres.Count > 0)
                {
                    <div class="media-info-genres">@string.Join(" · ", Details.Genres)</div>
                }
                @if (MediaType == "tv" && Details.Creators is { Count: > 0 })
                {
                    <div class="media-info-credits"><span><strong>@L["Details_CreatedBy"]</strong> @string.Join(" · ", Details.Creators)</span></div>
                }
                else if (Details.Directors is { Count: > 0 })
                {
                    <div class="media-info-credits"><span><strong>@L["Details_Direction"]</strong> @string.Join(" · ", Details.Directors)</span></div>
                }
                @if (Details.Cast is { Count: > 0 })
                {
                    <div class="media-info-credits"><span><strong>@L["Details_With"]</strong> @string.Join(" · ", Details.Cast)</span></div>
                }
                <p class="media-info-overview">@(string.IsNullOrWhiteSpace(Details.Overview) ? L["Details_NoOverview"] : Details.Overview)</p>
                <div class="media-info-actions">
                    @if (MediaType == "tv")
                    {
                        <AppButton Variant="light" Disabled="@(NextEpisodeToPlay is null && StreamingProviders.Count == 0)" OnClick="PlayAsync">@PlayButtonIcon <span>@PlayButtonLabel</span></AppButton>
                    }
                    else
                    {
                        <AppButton Variant="light" OnClick="PlayAsync">@PlayButtonIcon <span>@L["Home_Play"]</span></AppButton>
                    }
                    @if (!string.IsNullOrWhiteSpace(Details.TrailerUrl))
                    {
                        <AppButton Variant="glass" OnClick="() => ShowTrailer = true">▷ <span>@L["Details_Trailer"]</span></AppButton>
                    }
                </div>
            </div>
        </section>
        @if (MediaType == "tv")
        {
            <section class="series-episodes section" aria-label="Épisodes de @Details.Title">
                <div class="section-heading"><div><div class="eyebrow">@L["Details_EpisodeGuide"]</div><h2>@L["Details_Episodes"]</h2></div></div>
                @if (Details.Seasons.Count > 0)
                {
                    <div class="season-tabs" role="tablist" aria-label="Saisons">
                        @foreach (var season in Details.Seasons.Where(item => item.EpisodeCount > 0).OrderBy(item => item.SeasonNumber))
                        {
                            <button type="button" role="tab" aria-selected="@(SelectedSeasonNumber == season.SeasonNumber)" class="@(SelectedSeasonNumber == season.SeasonNumber ? "active" : "")" @onclick="() => SelectSeason(season.SeasonNumber)">@season.Name</button>
                        }
                    </div>
                    @if (SelectedEpisodes.Count > 0)
                    {
                        <div class="episode-list" role="tabpanel">
                            @foreach (var episode in SelectedEpisodes)
                            {
                                var progress = FindProgress(episode);
                                <article class="episode-card" @key="episode.EpisodeNumber">
                                    <div class="episode-still">
                                        @if (!string.IsNullOrWhiteSpace(episode.Still)) { <img src="@episode.Still" alt="Image de l’épisode @episode.EpisodeNumber" loading="lazy" /> }
                                        else { <span>S@episode.SeasonNumber.ToString("00") · E@episode.EpisodeNumber.ToString("00")</span> }
                                    </div>
                                    <div class="episode-copy">
                                        <div class="episode-heading"><strong>@episode.EpisodeNumber.ToString("00") · @episode.Title</strong>@if (progress?.IsCompleted == true) { <span class="episode-watched">@L["Details_Watched"]</span> }</div>
                                        <small>@string.Format(L["Details_SeasonEpisode"], episode.SeasonNumber, episode.EpisodeNumber)@if (!string.IsNullOrWhiteSpace(episode.AirDate)) { <span> · @FormatAirDate(episode.AirDate)</span> }@if (episode.RuntimeMinutes is not null) { <span> · @FormatRuntime(episode.RuntimeMinutes.Value)</span> }</small>
                                        <p>@(string.IsNullOrWhiteSpace(episode.Overview) ? L["Details_NoSummary"] : episode.Overview)</p>
                                        @if (progress is { IsCompleted: false })
                                        {
                                            <div class="episode-progress"><span style="width:@($"{progress.ProgressPercent:0.#}%")"></span></div>
                                            <small>@L["Details_InProgress"] · @progress.ProgressPercent.ToString("0") %</small>
                                        }
                                        <AppButton Variant="light" Class="episode-play" OnClick="() => PlayEpisodeAsync(episode)">@PlayButtonIcon <span>@L[progress is { IsCompleted: false } ? "Details_ResumeEpisode" : "Details_PlayEpisode"]</span></AppButton>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="episode-empty">@L["Details_NoEpisodes"]</p>
                    }
                }
                else
                {
                    <p class="episode-empty">@L["Details_EpisodesUnavailable"]</p>
                }
            </section>
        }
    </div>
}

@if (ShowTrailer && Details is not null)
{
    <AppModal IsOpen="true" PanelClass="trailer-dialog" PanelStyle="--app-modal-width:1000px;--app-modal-padding:0;--app-modal-background:#000;--app-modal-border:1px solid #45464f;--app-modal-radius:8px;aspect-ratio:16/9" AriaLabel="@($"Bande-annonce de {Details.Title}")" ShowCloseButton="true" OnClose="CloseTrailer">
            <iframe class="trailer-frame" src="@Details.TrailerUrl" title="Bande-annonce de @Details.Title" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
    </AppModal>
}

@code {
    [Parameter] public string MediaType { get; set; } = "movie";
    [Parameter] public int TmdbId { get; set; }

    private MediaDetails? Details;
    private bool IsLoading = true;
    private string? ErrorMessage;
    private bool ShowTrailer;
    private void CloseTrailer() => ShowTrailer = false;
    private int SelectedSeasonNumber;
    private Dictionary<int, List<EpisodeDetails>> EpisodesBySeason = [];
    private List<WatchProgressEntry> EpisodeProgress = [];
    private List<StreamingProviderAvailability> StreamingProviders = [];
    private List<EpisodeDetails> SelectedEpisodes => EpisodesBySeason.GetValueOrDefault(SelectedSeasonNumber) ?? [];
    private IEnumerable<EpisodeDetails> AllEpisodes => EpisodesBySeason.Values.SelectMany(items => items).OrderBy(item => item.SeasonNumber).ThenBy(item => item.EpisodeNumber);
    private WatchProgressEntry? CurrentEpisodeProgress => EpisodeProgress.Where(item => !item.IsCompleted).OrderByDescending(item => item.UpdatedAt).FirstOrDefault();
    private bool HasEpisodeInProgress => CurrentEpisodeProgress is not null;
    private string PlayButtonLabel => StreamingProviders.FirstOrDefault() is { } provider
        ? $"Regarder sur {provider.Name}"
        : NextEpisodeToPlay is { } episode
        ? $"{L[HasEpisodeInProgress ? "Details_ResumeEpisode" : "Home_Play"]} · S{episode.SeasonNumber:00}E{episode.EpisodeNumber:00}"
        : L["Details_SeriesEnded"];
    private RenderFragment PlayButtonIcon => builder =>
    {
        if (StreamingProviders.Count == 0) { builder.AddContent(0, "▶"); return; }
        var sequence = 0;
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "play-provider-icons");
        foreach (var provider in StreamingProviders)
        {
            builder.OpenElement(sequence++, "img");
            builder.AddAttribute(sequence++, "src", provider.LogoUrl);
            builder.AddAttribute(sequence++, "alt", provider.Name);
            builder.AddAttribute(sequence++, "title", $"Disponible sur {provider.Name}");
            builder.CloseElement();
        }
        builder.CloseElement();
    };
    private EpisodeDetails? NextEpisodeToPlay =>
        (CurrentEpisodeProgress is { } current ? AllEpisodes.FirstOrDefault(episode => episode.SeasonNumber == current.SeasonNumber && episode.EpisodeNumber == current.EpisodeNumber) : null)
        ?? AllEpisodes.FirstOrDefault(episode => episode.SeasonNumber > 0 && !IsWatched(episode));
    private string CatalogUrl => MediaType == "tv" ? "/series" : "/films";
    private string BackdropStyle => string.IsNullOrWhiteSpace(Details?.Backdrop) ? "" : $"background-image: linear-gradient(90deg,#090a0e 0%,rgba(9,10,14,.9) 32%,rgba(9,10,14,.22) 78%),linear-gradient(0deg,#090a0e 0%,transparent 58%),url('{Details.Backdrop}')";

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        Details = null;
        EpisodesBySeason = [];
        EpisodeProgress = [];
        StreamingProviders = [];
        try
        {
            var type = MediaType == "tv" ? "tv" : "movie";
            var response = await Http.GetAsync($"/api/catalog/{type}/{TmdbId}");
            if (!response.IsSuccessStatusCode) ErrorMessage = "TMDB n’a pas fourni de fiche pour ce média.";
            else
            {
                Details = await response.Content.ReadFromJsonAsync<MediaDetails>();
                if (Details is not null)
                {
                    var availability = LoadStreamingAvailabilityAsync(type);
                    if (type == "tv") await Task.WhenAll(LoadEpisodesAsync(), availability);
                    else await availability;
                }
            }
        }
        catch (HttpRequestException) { ErrorMessage = "Impossible de joindre TMDB."; }
        finally { IsLoading = false; }
    }

    private async Task PlayAsync()
    {
        if (StreamingProviders.FirstOrDefault() is { } provider)
        {
            Navigation.NavigateTo(provider.SearchUrl, forceLoad: true);
            return;
        }
        if (MediaType != "tv")
        {
            Navigation.NavigateTo($"/lecture/movie/{TmdbId}");
            return;
        }
        var episode = NextEpisodeToPlay;
        if (episode is not null) await PlayEpisodeAsync(episode);
    }

    private async Task LoadStreamingAvailabilityAsync(string type)
    {
        try
        {
            var title = Uri.EscapeDataString(Details?.Title ?? "");
            StreamingProviders = await Http.GetFromJsonAsync<List<StreamingProviderAvailability>>($"/api/streaming/{type}/{TmdbId}?title={title}") ?? [];
        }
        catch (HttpRequestException) { StreamingProviders = []; }
    }

    private async Task LoadEpisodesAsync()
    {
        var seasons = Details!.Seasons.Where(season => season.EpisodeCount > 0).OrderBy(season => season.SeasonNumber).ToArray();
        EpisodeProgress = (await Http.GetFromJsonAsync<List<WatchProgressEntry>>("/api/watch-progress") ?? [])
            .Where(item => item.TmdbId == TmdbId && item.MediaType == "tv" && item.SeasonNumber is not null && item.EpisodeNumber is not null).ToList();
        if (seasons.Length == 0) return;
        var loaded = await Task.WhenAll(seasons.Select(async season =>
        {
            try
            {
                var data = await Http.GetFromJsonAsync<SeasonEpisodesResponse>($"/api/catalog/tv/{TmdbId}/season/{season.SeasonNumber}");
                return (season.SeasonNumber, Episodes: data?.Episodes ?? []);
            }
            catch (HttpRequestException) { return (season.SeasonNumber, Episodes: new List<EpisodeDetails>()); }
        }));
        EpisodesBySeason = loaded.ToDictionary(item => item.SeasonNumber, item => item.Episodes.OrderBy(episode => episode.EpisodeNumber).ToList());
        SelectedSeasonNumber = CurrentEpisodeProgress?.SeasonNumber
            ?? seasons.FirstOrDefault(season => season.SeasonNumber > 0 && !EpisodesBySeason.GetValueOrDefault(season.SeasonNumber, []).All(IsWatched))?.SeasonNumber
            ?? seasons.First().SeasonNumber;
    }

    private void SelectSeason(int seasonNumber) => SelectedSeasonNumber = seasonNumber;

    private WatchProgressEntry? FindProgress(EpisodeDetails episode) => EpisodeProgress.FirstOrDefault(item =>
        item.SeasonNumber == episode.SeasonNumber && item.EpisodeNumber == episode.EpisodeNumber);

    private bool IsWatched(EpisodeDetails episode) => FindProgress(episode)?.IsCompleted == true;

    private async Task PlayEpisodeAsync(EpisodeDetails episode)
    {
        if (StreamingProviders.FirstOrDefault() is { } provider)
        {
            Navigation.NavigateTo(provider.SearchUrl, forceLoad: true);
            return;
        }
        var query = $"seasonNumber={episode.SeasonNumber}&episodeNumber={episode.EpisodeNumber}&episodeTitle={Uri.EscapeDataString(episode.Title ?? "")}";
        Navigation.NavigateTo($"/lecture/tv/{TmdbId}?{query}");
    }

    private static string FormatRuntime(int minutes) => minutes >= 60 ? $"{minutes / 60} h {minutes % 60:00}" : $"{minutes} min";
    private static string FormatAirDate(string date) => DateTime.TryParse(date, System.Globalization.CultureInfo.InvariantCulture, out var parsed) ? parsed.ToString("d MMM yyyy", System.Globalization.CultureInfo.CurrentCulture) : date;

    private sealed record MediaDetails(int Id, string Title, string? Overview, string? Poster, string? Backdrop,
        string MediaType, double Rating, string? OriginalLanguage, int? Year, List<string> Genres,
        int? RuntimeMinutes, int? SeasonCount, int? EpisodeCount, List<SeasonSummary> Seasons, string? TrailerUrl,
        List<string>? Directors = null, List<string>? Creators = null, List<string>? Cast = null);
    private sealed record SeasonSummary(int SeasonNumber, string Name, int EpisodeCount, string? Poster);
    private sealed record SeasonEpisodesResponse(int SeasonNumber, List<EpisodeDetails> Episodes);
    private sealed record StreamingProviderAvailability(string Name, string LogoUrl, string SearchUrl);
    private sealed record EpisodeDetails(int Id, int SeasonNumber, int EpisodeNumber, string? Title, string? Overview, string? Still, string? AirDate, int? RuntimeMinutes);
}
