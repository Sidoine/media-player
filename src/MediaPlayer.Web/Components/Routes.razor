@inject media_player.Services.ApiCredentialStore Credentials
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @if (!Credentials.IsFullyConfigured && routeData.PageType != typeof(media_player.Components.Pages.Settings))
        {
            <CredentialRedirect />
        }
        else
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        }
    </Found>
    <NotFound>
        <PageTitle>Page introuvable · Écran</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <section class="not-found"><h1>Cette page n’existe pas</h1><a href="/">Retour à l’accueil</a></section>
        </LayoutView>
    </NotFound>
</Router>
