@inherits LayoutComponentBase
<div class="shell">
    <header class="topbar">
        <a class="wordmark" href="/" aria-label="Bobine, @L["Nav_Home"]">BOBINE</a>
        <nav aria-label="@L["Nav_Home"]">
            <NavLink href="/" Match="NavLinkMatch.All">@L["Nav_Home"]</NavLink>
            <NavLink href="/films">@L["Nav_Movies"]</NavLink>
            <NavLink href="/series">@L["Nav_Series"]</NavLink>
            <a href="/bibliotheque">@L["Nav_Library"]</a>
        </nav>
        <CatalogSearch />
        <AppButton Variant="light" Class="profile" Href="/configuration" Title="@L["Nav_Settings"]" AriaLabel="@L["Nav_Settings"]">⚙</AppButton>
    </header>
    <main>@Body</main>
    <footer>ÉCRAN <span>@L["Footer_TmdbDisclaimer"]</span></footer>
</div>
